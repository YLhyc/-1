[
  {
    "text": "高质量发展是全面建设社会主义现代化国家的首要任务。",
    "start": 0.1,
    "end": 5.165
  },
  {
    "text": "发展新质生产力是推动高质量发展的内在要求和重要着力点。",
    "start": 5.115,
    "end": 11.008
  },
  {
    "text": "新质生产力究竟新在哪里？",
    "start": 11.008,
    "end": 13.865
  },
  {
    "text": "质在哪里？",
    "start": 13.865,
    "end": 15.281
  },
  {
    "text": "新质生产力是创新起主导作用，具有高科技，高效能，高质量特征。",
    "start": 15.281,
    "end": 21.659
  },
  {
    "text": "符合新发展理念的先进生产力质态。",
    "start": 21.658,
    "end": 25.051
  },
  {
    "text": "它的特点是创新，关键在质优，本质是先进生产力。",
    "start": 25.051,
    "end": 30.166
  },
  {
    "text": "新质生产力由技术革命性突破，生产要素创新性配置，产业深度转型升级而催生。",
    "start": 30.166,
    "end": 38.023
  },
  {
    "text": "以劳动者，劳动资料，劳动对象及其优化组合的跃升为基本内涵。",
    "start": 38.023,
    "end": 44.094
  },
  {
    "text": "以全要素生产率大幅提升为核心标志。",
    "start": 44.094,
    "end": 48.061
  },
  {
    "text": "推动新质生产力发展，必须因地制宜，防止一哄而上，泡沫化，也不要搞一种模式。",
    "start": 48.061,
    "end": 55.433
  },
  {
    "text": "要统筹推进传统产业改造升级，新兴产业培育壮大，未来产业前瞻布局。",
    "start": 55.434,
    "end": 62.309
  },
  {
    "text": "同时要构建以国内大循环为主体，国内国际双循环相互促进的新发展格局。",
    "start": 62.309,
    "end": 69.541
  },
  {
    "text": "新发展格局最本质的特征是实现高水平的自立自强。",
    "start": 69.541,
    "end": 74.579
  },
  {
    "text": "考场大题核心必背。",
    "start": 74.579,
    "end": 76.888
  },
  {
    "text": "核心标志是全要素生产率大幅提升，必须因地制宜。",
    "start": 76.888,
    "end": 82.118
  },
  {
    "text": "新发展格局本质是高水平自立自强。",
    "start": 82.117,
    "end": 86.046
  },
  {
    "text": "高质发展首任务，新质生产力为先，科技创新引要素，自立自强稳行船。",
    "start": 86.046,
    "end": 92.832
  }
]