[
  {
    "text": "大革命失败后，中国共产党人没有被吓倒。",
    "start": 0.1,
    "end": 4.004
  },
  {
    "text": "八七会议在汉口秘密召开，彻底清算了陈独秀右倾机会主义错误。",
    "start": 3.954,
    "end": 10.064
  },
  {
    "text": "确立了土地革命和武装起义的总方针。",
    "start": 10.064,
    "end": 13.827
  },
  {
    "text": "毛泽东在会上提出了著名的枪杆子里面出政权的科学论断。",
    "start": 13.827,
    "end": 19.286
  },
  {
    "text": "党先后发动了南昌起义，秋收起义和广州起义。",
    "start": 19.286,
    "end": 23.891
  },
  {
    "text": "南昌起义打响了武装反抗国民党反动派的第一枪，是中国共产党独立领导革命战争。",
    "start": 23.89,
    "end": 31.492
  },
  {
    "text": "创建人民军队的开端。",
    "start": 31.492,
    "end": 33.826
  },
  {
    "text": "秋收起义后，毛泽东毅然率领部队引兵井冈山，建立了第一个农村革命根据地。",
    "start": 33.827,
    "end": 40.868
  },
  {
    "text": "井冈山革命根据地。",
    "start": 40.867,
    "end": 43.048
  },
  {
    "text": "三湾改编确立了党指挥枪和支部建在连上的根本原则。",
    "start": 43.048,
    "end": 48.163
  },
  {
    "text": "古田会议进一步确立了思想建党，政治建军的原则。",
    "start": 48.163,
    "end": 53.023
  },
  {
    "text": "农村包围城市，武装夺取政权道路的开辟。",
    "start": 53.023,
    "end": 57.117
  },
  {
    "text": "标志着党在实践中找到了中国革命的正确道路。",
    "start": 57.117,
    "end": 61.773
  },
  {
    "text": "考场题眼。",
    "start": 61.773,
    "end": 63.227
  },
  {
    "text": "八七会议提出枪杆子出政权，南昌起义建军开端，三湾改编支部建在连上。",
    "start": 63.227,
    "end": 70.446
  },
  {
    "text": "汉口八七转危局，南昌首义军旗红，井冈星火连天起，支部连上铸铁军。",
    "start": 70.446,
    "end": 77.818
  }
]