[
  {
    "text": "考察单个资本循环之后，我们放眼全社会。",
    "start": 0.1,
    "end": 3.966
  },
  {
    "text": "社会总资本再生产是怎样实现的。",
    "start": 3.916,
    "end": 7.424
  },
  {
    "text": "社会总资本再生产的核心问题是社会总产品的实现问题。",
    "start": 7.423,
    "end": 12.589
  },
  {
    "text": "即社会总产品的价值补偿和实物替换。",
    "start": 12.589,
    "end": 16.352
  },
  {
    "text": "社会总产品从实物形态上分为生产资料和生活资料两大部类。",
    "start": 16.352,
    "end": 22.156
  },
  {
    "text": "从价值形态上由不变资本西，可变资本微和剩余价值爱慕三部分组成。",
    "start": 22.156,
    "end": 28.84
  },
  {
    "text": "只有两大部类内部及两大部类之间的产品在价值上得到补偿，在实物上得到替换。",
    "start": 28.839,
    "end": 36.237
  },
  {
    "text": "扩大再生产才能顺利进行。",
    "start": 36.237,
    "end": 39.132
  },
  {
    "text": "剩余价值生产出来后，在资产阶级各集团之间进行瓜分。",
    "start": 39.132,
    "end": 44.349
  },
  {
    "text": "剩余价值首先转化为利润。",
    "start": 44.349,
    "end": 47.244
  },
  {
    "text": "剩余价值是利润的本质，利润是剩余价值的转化形式。",
    "start": 47.245,
    "end": 52.079
  },
  {
    "text": "不同生产部门由于资本有机构成不同，利润率存在差异。",
    "start": 52.079,
    "end": 57.156
  },
  {
    "text": "资本为了追逐高利润在部门之间自由转移，展开竞争，最终导致利润率平均化。",
    "start": 57.156,
    "end": 64.388
  },
  {
    "text": "形成平均利润。",
    "start": 64.388,
    "end": 66.161
  },
  {
    "text": "随着平均利润的形成，商品价值转化为生产价格。",
    "start": 66.161,
    "end": 70.817
  },
  {
    "text": "生产价格等于成本价格加平均利润。",
    "start": 70.816,
    "end": 74.477
  },
  {
    "text": "全社会剩余价值总量等于平均利润总量，生产价格总额等于价值总额。",
    "start": 74.477,
    "end": 80.867
  },
  {
    "text": "补偿替换求周全，价值实物两相连，自由竞争平利润，生产价格破万弦。",
    "start": 80.867,
    "end": 88.15
  }
]