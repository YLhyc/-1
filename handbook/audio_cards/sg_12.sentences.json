[
  {
    "text": "随着1931年九一八事变爆发，日本军国主义发动侵华战争。",
    "start": 0.1,
    "end": 5.892
  },
  {
    "text": "中日民族矛盾逐渐上升为主要矛盾。",
    "start": 5.842,
    "end": 9.375
  },
  {
    "text": "1935年华北事变后，民族危机空前严重。",
    "start": 9.375,
    "end": 13.444
  },
  {
    "text": "北平学生掀起了伟大的一二九运动，促进了中华民族的觉醒。",
    "start": 13.444,
    "end": 18.852
  },
  {
    "text": "标志着中国人民抗日救亡运动新高潮的到来。",
    "start": 18.852,
    "end": 22.946
  },
  {
    "text": "中国共产党在陕北瓦窑堡会议上，明确提出了建立抗日民族统一战线的方针。",
    "start": 22.946,
    "end": 29.885
  },
  {
    "text": "毛泽东发表《论反对日本帝国主义的策略》，奠定了抗日民族统一战线的理论基础。",
    "start": 29.885,
    "end": 36.786
  },
  {
    "text": "1936年张学良，杨虎城发动西安事变。",
    "start": 36.786,
    "end": 40.804
  },
  {
    "text": "中国共产党从全民族利益出发，主张和平解决西安事变。",
    "start": 40.804,
    "end": 46.136
  },
  {
    "text": "西安事变的和平解决成为时局转换的枢纽，十年内战局面基本结束。",
    "start": 46.135,
    "end": 52.411
  },
  {
    "text": "国内和平初步实现。",
    "start": 52.411,
    "end": 54.617
  },
  {
    "text": "七七事变后，抗日民族统一战线正式形成，全民族抗战全面爆发。",
    "start": 54.617,
    "end": 60.599
  },
  {
    "text": "考场选择题陷阱。",
    "start": 60.599,
    "end": 62.716
  },
  {
    "text": "一二九运动促进民族觉醒迎来新高潮，西安事变和平解决是时局转换的枢纽。",
    "start": 62.717,
    "end": 70.166
  },
  {
    "text": "一二九动呼救亡，瓦窑堡里谋统战，西安和平转枢纽，全民族抗起波澜。",
    "start": 70.166,
    "end": 77.041
  }
]