[
  {
    "text": "国家安全是民族复兴的根基，社会稳定是国家强盛的前提。",
    "start": 0.1,
    "end": 5.905
  },
  {
    "text": "在新时代，中国共产党创造性地提出了总体国家安全观。",
    "start": 5.855,
    "end": 11.238
  },
  {
    "text": "总体国家安全观的核心要义是。",
    "start": 11.237,
    "end": 14.247
  },
  {
    "text": "坚持以人民安全为宗旨，以政治安全为根本，以经济安全为基础。",
    "start": 14.247,
    "end": 20.28
  },
  {
    "text": "以军事科技文化社会安全为保障，以促进国际安全为依托。",
    "start": 20.281,
    "end": 25.689
  },
  {
    "text": "走出一条中国特色国家安全道路。",
    "start": 25.689,
    "end": 28.903
  },
  {
    "text": "统筹发展和安全，坚持底线思维，防范化解重大风险。",
    "start": 28.903,
    "end": 34.184
  },
  {
    "text": "强国必须强军，军强才能国安。",
    "start": 34.184,
    "end": 37.5
  },
  {
    "text": "党在新时代的强军目标是建设一支听党指挥，能打胜仗，作风优良的人民军队。",
    "start": 37.5,
    "end": 44.579
  },
  {
    "text": "把人民军队建设成为世界一流军队。",
    "start": 44.579,
    "end": 47.997
  },
  {
    "text": "坚持党对人民军队的绝对领导，这是人民军队的建军之本，强军之魂。",
    "start": 47.997,
    "end": 54.553
  },
  {
    "text": "考场题眼。",
    "start": 54.554,
    "end": 56.008
  },
  {
    "text": "宗旨是人民安全，根本是政治安全，基础是经济安全。",
    "start": 56.008,
    "end": 61.212
  },
  {
    "text": "建军之本强军之魂是党对军队绝对领导。",
    "start": 61.212,
    "end": 65.37
  },
  {
    "text": "总体安全固长城，政治为根民为本，听党指挥强军魂，威震四方保国珍。",
    "start": 65.37,
    "end": 72.5
  }
]