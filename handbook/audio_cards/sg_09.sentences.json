[
  {
    "text": "中国共产党成立后，迅速投入到工人运动与革命斗争中。",
    "start": 0.1,
    "end": 5.139
  },
  {
    "text": "中共二大第一次明确提出了反帝反封建的民主革命纲领，指明了现阶段革命目标。",
    "start": 5.089,
    "end": 12.436
  },
  {
    "text": "面对强大的反动统治，党认识到必须建立革命统一战线。",
    "start": 12.436,
    "end": 17.831
  },
  {
    "text": "1924年国民党一大召开，标志着第一次国共合作正式形成。",
    "start": 17.832,
    "end": 23.789
  },
  {
    "text": "大会通过了新三民主义，确立了联俄，联共，扶助农工的三大革命政策。",
    "start": 23.788,
    "end": 30.267
  },
  {
    "text": "成为国共合作的政治基础。",
    "start": 30.268,
    "end": 32.909
  },
  {
    "text": "国共合作掀起了轰轰烈烈的国民大革命。",
    "start": 32.908,
    "end": 36.645
  },
  {
    "text": "北伐战争胜利进军，基本上消灭了吴佩孚，孙传芳两大封建军阀。",
    "start": 36.645,
    "end": 43.112
  },
  {
    "text": "但在革命胜利发展的关键时刻，蒋介石发动四一二反革命政变。",
    "start": 43.112,
    "end": 48.788
  },
  {
    "text": "汪精卫发动七一五反革命政变，大革命惨遭失败。",
    "start": 48.788,
    "end": 53.354
  },
  {
    "text": "失败的原因除国民党右派叛变外，主观上在于以陈独秀为代表的右倾机会主义错误。",
    "start": 53.355,
    "end": 61.072
  },
  {
    "text": "放弃了对革命和武装的领导权。",
    "start": 61.071,
    "end": 64.081
  },
  {
    "text": "惨痛教训让共产党人深刻认识到。",
    "start": 64.082,
    "end": 67.641
  },
  {
    "text": "中国革命必须坚持无产阶级领导权，必须掌握革命武装。",
    "start": 67.64,
    "end": 73.137
  },
  {
    "text": "考场考眼。",
    "start": 73.138,
    "end": 74.63
  },
  {
    "text": "国共合作政治基础是新三民主义，大革命失败主观原因是陈独秀右倾放弃领导权。",
    "start": 74.63,
    "end": 82.474
  },
  {
    "text": "国共合作打北伐，三大政策定同盟，右倾妥协失武装，血的教训换自醒。",
    "start": 82.474,
    "end": 89.413
  }
]