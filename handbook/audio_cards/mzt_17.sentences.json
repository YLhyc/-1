[
  {
    "text": "邓小平理论是中特理论体系的开篇之作。",
    "start": 0.1,
    "end": 3.877
  },
  {
    "text": "邓小平理论的形成，首先从破除思想禁区开始。",
    "start": 3.827,
    "end": 8.253
  },
  {
    "text": "邓小平深刻指出。",
    "start": 8.253,
    "end": 10.358
  },
  {
    "text": "什么是社会主义，怎样建设社会主义。",
    "start": 10.357,
    "end": 13.89
  },
  {
    "text": "这是建设中国特色社会主义的首要基本理论问题。",
    "start": 13.89,
    "end": 18.214
  },
  {
    "text": "过去搞社会主义，往往抽象地看待社会主义，把贫穷当成光荣。",
    "start": 18.214,
    "end": 23.979
  },
  {
    "text": "把计划经济等同于社会主义。",
    "start": 23.98,
    "end": 26.952
  },
  {
    "text": "邓小平明确提出了社会主义本质理论。",
    "start": 26.952,
    "end": 30.613
  },
  {
    "text": "社会主义的本质，是解放生产力，发展生产力，消灭剥削，消除两极分化。",
    "start": 30.612,
    "end": 37.666
  },
  {
    "text": "最终达到共同富裕。",
    "start": 37.666,
    "end": 39.898
  },
  {
    "text": "这个论断把我们对社会主义的认识提高到了全新的科学水平。",
    "start": 39.898,
    "end": 45.191
  },
  {
    "text": "首先，它把解放和发展生产力纳入社会主义本质。",
    "start": 45.191,
    "end": 49.821
  },
  {
    "text": "纠正了过去忽视生产力发展的错误。",
    "start": 49.821,
    "end": 53.303
  },
  {
    "text": "其次，它把消灭剥削，消除两极分化，实现共同富裕作为最终目标。",
    "start": 53.303,
    "end": 59.757
  },
  {
    "text": "指明了社会主义与资本主义的本质区别。",
    "start": 59.758,
    "end": 63.585
  },
  {
    "text": "考场避坑高频点。",
    "start": 63.584,
    "end": 65.701
  },
  {
    "text": "社会主义的根本任务是解放和发展生产力，社会主义的最终目标是实现共同富裕。",
    "start": 65.702,
    "end": 72.832
  },
  {
    "text": "首要问题求真解，解放发展生产力，消灭剥削避两极，共同富裕是真谛。",
    "start": 72.832,
    "end": 79.86
  }
]