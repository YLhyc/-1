[
  {
    "text": "五对基本范畴的后两对，是本质与现象，内容与形式。",
    "start": 0.1,
    "end": 4.91
  },
  {
    "text": "本质是事物的根本性质和内在联系，深藏于内部，只有通过理性思维才能把握。",
    "start": 4.86,
    "end": 12.067
  },
  {
    "text": "现象是事物外部联系和表面特征，显现于外部，可以被感官直接感知。",
    "start": 12.066,
    "end": 18.482
  },
  {
    "text": "任何本质都会通过现象表现出来，任何现象都从某一侧面表现着本质。",
    "start": 18.482,
    "end": 24.796
  },
  {
    "text": "真象从正面直接表现本质，假象从反面歪曲颠倒地表现本质。",
    "start": 24.796,
    "end": 30.74
  },
  {
    "text": "考场红线。",
    "start": 30.74,
    "end": 32.22
  },
  {
    "text": "假象也是客观存在的，假象绝不等同于错觉，错觉是主观的，假象是客观的。",
    "start": 32.219,
    "end": 39.591
  },
  {
    "text": "第二对是内容与形式。",
    "start": 39.592,
    "end": 41.901
  },
  {
    "text": "内容是构成事物一切要素的总和，是事物存在的基础。",
    "start": 41.901,
    "end": 46.748
  },
  {
    "text": "形式是内容各要素的组织结构和表现方式。",
    "start": 46.747,
    "end": 50.739
  },
  {
    "text": "内容决定形式，形式反作用于内容，新内容要求新形式。",
    "start": 50.74,
    "end": 55.931
  },
  {
    "text": "形式对内容具有相对独立性。",
    "start": 55.931,
    "end": 58.826
  },
  {
    "text": "大题方法论。",
    "start": 58.827,
    "end": 60.434
  },
  {
    "text": "现象是入门的向导，我们必须透过现象看本质，决不能被假象蒙蔽双眼。",
    "start": 60.434,
    "end": 66.926
  },
  {
    "text": "表面纷繁显本质，真象假象皆客观，内容为王定架构，形式相随相得安。",
    "start": 66.926,
    "end": 73.865
  }
]