[
  {
    "text": "在社会主义改造过程中。",
    "start": 0.1,
    "end": 2.537
  },
  {
    "text": "中国共产党创造性地开辟了一条具有中国特色的社会主义改造道路。",
    "start": 2.487,
    "end": 8.469
  },
  {
    "text": "首先看农业和手工业的改造。",
    "start": 8.469,
    "end": 11.301
  },
  {
    "text": "坚持积极领导，稳步前进的方针，遵循自愿互助，典型示范和国家帮助的原则。",
    "start": 11.301,
    "end": 18.699
  },
  {
    "text": "采取梯次推进的过渡形式。",
    "start": 18.699,
    "end": 21.378
  },
  {
    "text": "农业从互助组，所谓具有社会主义萌芽，发展到初级社，所谓半社会主义性质。",
    "start": 21.378,
    "end": 28.381
  },
  {
    "text": "再到高级社，所谓完全社会主义公有制性质。",
    "start": 28.38,
    "end": 32.564
  },
  {
    "text": "手工业也经历了从供销合作小组到手工业生产合作社的平稳过渡。",
    "start": 32.564,
    "end": 38.674
  },
  {
    "text": "其次看资本主义工商业的改造。",
    "start": 38.673,
    "end": 41.619
  },
  {
    "text": "创造性地运用马克思恩格斯和列宁提出的设想。",
    "start": 41.62,
    "end": 45.931
  },
  {
    "text": "用和平赎买的方法改造资本主义工商业。",
    "start": 45.931,
    "end": 49.783
  },
  {
    "text": "采取从低级到高级的国家资本主义过渡形式。",
    "start": 49.783,
    "end": 53.941
  },
  {
    "text": "初级形式包括统购包销，委托加工。",
    "start": 53.941,
    "end": 57.717
  },
  {
    "text": "高级形式是个别企业的公私合营与全行业的公私合营。",
    "start": 57.717,
    "end": 62.717
  },
  {
    "text": "把对企业的改造与对人的改造相结合，把资本家改造为自食其力的社会主义劳动者。",
    "start": 62.717,
    "end": 69.873
  },
  {
    "text": "考场大题核心题眼。",
    "start": 69.872,
    "end": 72.142
  },
  {
    "text": "和平赎买政策的成功实现，是中国共产党对马克思主义的一大创造性贡献。",
    "start": 72.143,
    "end": 78.903
  },
  {
    "text": "民族资产阶级具有两面性，工人阶级掌握政权，为和平赎买创造了历史条件。",
    "start": 78.903,
    "end": 86.301
  },
  {
    "text": "阶梯过渡社员聚，和平赎买创奇勋，改造公私兼化人，中国特色满庭春。",
    "start": 86.301,
    "end": 92.946
  }
]