[
  {
    "text": "三大规律的第三条，是否定之否定规律。",
    "start": 0.1,
    "end": 3.889
  },
  {
    "text": "它揭示了事物发展的方向和道路是螺旋式上升，波浪式前进。",
    "start": 3.839,
    "end": 9.273
  },
  {
    "text": "辩证否定观的本质究竟是什么？",
    "start": 9.273,
    "end": 12.462
  },
  {
    "text": "形而上学把否定看作外力强加的毁灭，要么全盘肯定，要么全盘否定。",
    "start": 12.462,
    "end": 19.005
  },
  {
    "text": "辩证否定观则主张，否定是事物的自我否定，是发展和联系的环节。",
    "start": 19.005,
    "end": 25.191
  },
  {
    "text": "辩证否定的实质是扬弃。",
    "start": 25.191,
    "end": 27.933
  },
  {
    "text": "扬弃就是既克服又保留，克服旧事物中过时的消极因素。",
    "start": 27.934,
    "end": 33.164
  },
  {
    "text": "保留吸纳其中合理的积极因素。",
    "start": 33.163,
    "end": 36.224
  },
  {
    "text": "事物经过两次否定，三个阶段。",
    "start": 36.224,
    "end": 39.285
  },
  {
    "text": "肯定，否定，否定之否定，形成一个周期。",
    "start": 39.286,
    "end": 43.38
  },
  {
    "text": "在形式上仿佛又回到了最初的出发点，但在内容上达到了更高的层次。",
    "start": 43.38,
    "end": 49.515
  },
  {
    "text": "方法论启示。",
    "start": 49.515,
    "end": 51.084
  },
  {
    "text": "前途是光明的，道路是曲折的。",
    "start": 51.084,
    "end": 54.196
  },
  {
    "text": "考场避坑。",
    "start": 54.196,
    "end": 55.765
  },
  {
    "text": "辩证否定是事物内部矛盾推动的自我否定，绝不是外力毁灭。",
    "start": 55.765,
    "end": 61.25
  },
  {
    "text": "批判继承传统文化，必须坚持扬弃原则，取其精华去其糟粕。",
    "start": 61.25,
    "end": 67.105
  },
  {
    "text": "自我否定非外灭，扬弃辩证续长波，螺旋上升路曲折，光明前途任蹉跎。",
    "start": 67.105,
    "end": 73.98
  }
]