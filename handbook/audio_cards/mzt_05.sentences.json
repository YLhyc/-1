[
  {
    "text": "毛泽东思想的历史地位是怎样的。",
    "start": 0.1,
    "end": 3.341
  },
  {
    "text": "怎样科学评价毛泽东同志的一生。",
    "start": 3.291,
    "end": 6.39
  },
  {
    "text": "毛泽东思想是马克思列宁主义在中国的创造性运用和发展。",
    "start": 6.39,
    "end": 11.938
  },
  {
    "text": "是马克思主义中国化时代化的第一次历史性飞跃。",
    "start": 11.939,
    "end": 16.123
  },
  {
    "text": "它是中国共产党和中国人民弥足珍贵的精神财富。",
    "start": 16.122,
    "end": 21.249
  },
  {
    "text": "是我们在新时代必须长期坚持并发展的指导思想。",
    "start": 21.25,
    "end": 25.931
  },
  {
    "text": "对于毛泽东同志的科学评价，关系到党和国家的前途命运。",
    "start": 25.931,
    "end": 31.25
  },
  {
    "text": "邓小平同志和党中央在《关于建国以来党。",
    "start": 31.25,
    "end": 35.153
  },
  {
    "text": "的若干历史问题的决议》中作出了科学结论。",
    "start": 35.153,
    "end": 39.094
  },
  {
    "text": "毛泽东同志是伟大的马克思主义者，是伟大的无产阶级革命家，战略家和理论家。",
    "start": 39.094,
    "end": 46.428
  },
  {
    "text": "他为中国革命，军队建设和新中国成立立下了不可磨灭的功勋。",
    "start": 46.429,
    "end": 52.233
  },
  {
    "text": "虽然他在晚年犯了严重错误，但他的功绩是第一位的，错误是第二位的。",
    "start": 52.232,
    "end": 58.354
  },
  {
    "text": "必须把毛泽东同志晚年的错误，同经过长期历史检验的科学理论。",
    "start": 58.355,
    "end": 64.006
  },
  {
    "text": "毛泽东思想严格区分开来。",
    "start": 64.005,
    "end": 66.913
  },
  {
    "text": "考场大题核心题眼。",
    "start": 66.913,
    "end": 69.183
  },
  {
    "text": "科学评价毛泽东，绝不能搞历史虚无主义，功绩第一，错误第二。",
    "start": 69.184,
    "end": 74.72
  },
  {
    "text": "捍卫毛泽东同志的历史地位就是捍卫党的根基。",
    "start": 74.719,
    "end": 78.954
  },
  {
    "text": "首度飞跃立丰碑，建党建军开基业，功绩第一千秋在，科学评判明是非。",
    "start": 78.954,
    "end": 85.727
  }
]