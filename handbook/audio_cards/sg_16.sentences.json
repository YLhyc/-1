[
  {
    "text": "抗战胜利后，中国面临着两种命运，两个前途的决战。",
    "start": 0.1,
    "end": 4.973
  },
  {
    "text": "国民党企图维持大地主大资产阶级专政，中国共产党代表人民争取光明的前途。",
    "start": 4.923,
    "end": 12.41
  },
  {
    "text": "为了争取和平民主，揭露蒋介石假和平真内战的阴谋。",
    "start": 12.411,
    "end": 17.372
  },
  {
    "text": "毛泽东毅然亲赴重庆进行谈判。",
    "start": 17.372,
    "end": 20.548
  },
  {
    "text": "国共双方签署了双十协定，确认了和平建国的基本方针。",
    "start": 20.548,
    "end": 25.841
  },
  {
    "text": "1946年6月，国民党撕毁政协决议，悍然发动全面内战。",
    "start": 25.842,
    "end": 31.352
  },
  {
    "text": "人民解放军坚持自卫反击，经过粉碎国民党全面进攻和重点进攻后，转入战略进攻。",
    "start": 31.352,
    "end": 39.579
  },
  {
    "text": "1947年夏，刘邓大军千里跃进大别山，揭开了人民解放战争战略进攻的序幕。",
    "start": 39.579,
    "end": 46.875
  },
  {
    "text": "毛泽东指出，这是一个历史的转折点。",
    "start": 46.875,
    "end": 50.293
  },
  {
    "text": "蒋介石二十年反革命统治由发展到消灭的转折点。",
    "start": 50.293,
    "end": 55.0
  },
  {
    "text": "帝国主义在华统治由发展到消灭的转折点。",
    "start": 55.0,
    "end": 59.324
  },
  {
    "text": "考场题眼。",
    "start": 59.324,
    "end": 60.778
  },
  {
    "text": "重庆谈判签署双十协定，千里跃进大别山标志战略进攻序幕。",
    "start": 60.778,
    "end": 66.569
  },
  {
    "text": "两个转折点是历史标志。",
    "start": 66.569,
    "end": 69.158
  },
  {
    "text": "重庆谈判赴鸿门，双十协定争和平，大别山头号角响，战略进攻转乾坤。",
    "start": 69.158,
    "end": 76.428
  }
]