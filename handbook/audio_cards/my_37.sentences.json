[
  {
    "text": "商品为什么会具有使用价值和价值这二因素呢？",
    "start": 0.1,
    "end": 4.144
  },
  {
    "text": "马克思给出了划时代的解答。",
    "start": 4.094,
    "end": 6.849
  },
  {
    "text": "这是由生产商品的劳动二重性决定的。",
    "start": 6.849,
    "end": 10.408
  },
  {
    "text": "劳动二重性是指具体劳动和抽象劳动。",
    "start": 10.408,
    "end": 14.362
  },
  {
    "text": "具体劳动是在具体的特定形式下进行的劳动，比如木匠做桌子，裁缝做衣服。",
    "start": 14.362,
    "end": 21.492
  },
  {
    "text": "具体劳动创造商品的使用价值，体现人与自然的关系。",
    "start": 21.492,
    "end": 26.428
  },
  {
    "text": "抽象劳动是撇开具体形式的无差别的一般人类脑力和体力消耗。",
    "start": 26.429,
    "end": 32.143
  },
  {
    "text": "抽象劳动形成商品的价值，体现人与人之间的社会生产关系。",
    "start": 32.143,
    "end": 37.615
  },
  {
    "text": "具体劳动和抽象劳动不是两次劳动，也不是两种独立的劳动。",
    "start": 37.615,
    "end": 43.202
  },
  {
    "text": "而是同一劳动过程的两个不同方面。",
    "start": 43.202,
    "end": 46.556
  },
  {
    "text": "劳动二重性理论是理解马克思主义政治经济学的枢纽。",
    "start": 46.556,
    "end": 51.441
  },
  {
    "text": "考场核心陷阱。",
    "start": 51.441,
    "end": 53.431
  },
  {
    "text": "具体劳动生产使用价值，但具体劳动并不是使用价值的唯一源泉。",
    "start": 53.431,
    "end": 59.222
  },
  {
    "text": "自然物质也是使用价值的源泉。",
    "start": 59.222,
    "end": 62.168
  },
  {
    "text": "抽象劳动则是价值的唯一源泉。",
    "start": 62.168,
    "end": 65.267
  },
  {
    "text": "具体劳动造用值，抽象劳动聚价值，同一过程双重面，政经枢纽启真知。",
    "start": 65.268,
    "end": 71.939
  }
]