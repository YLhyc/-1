[
  {
    "text": "推进中国式现代化，必须用好关键一招。",
    "start": 0.1,
    "end": 4.068
  },
  {
    "text": "全面深化改革。",
    "start": 4.018,
    "end": 5.97
  },
  {
    "text": "党的二十届三中全会对进一步全面深化改革。",
    "start": 5.969,
    "end": 10.306
  },
  {
    "text": "推进中国式现代化作出了系统战略部署。",
    "start": 10.306,
    "end": 14.235
  },
  {
    "text": "全面深化改革的总目标是。",
    "start": 14.235,
    "end": 16.888
  },
  {
    "text": "继续完善和发展中国特色社会主义制度，推进国家治理体系和治理能力现代化。",
    "start": 16.888,
    "end": 24.005
  },
  {
    "text": "进一步全面深化改革必须贯彻六大原则。",
    "start": 24.005,
    "end": 27.882
  },
  {
    "text": "第一，坚持党的全面领导，这是根本保证。",
    "start": 27.882,
    "end": 31.862
  },
  {
    "text": "第二，坚持以人民为中心，尊重人民主体地位和首创精神。",
    "start": 31.862,
    "end": 37.653
  },
  {
    "text": "第三，坚持守正创新，既不走封闭僵化的老路，也不走改旗易帜的邪路。",
    "start": 37.653,
    "end": 44.196
  },
  {
    "text": "第四，坚持以制度建设为主线，加强顶层设计与制度集成。",
    "start": 44.196,
    "end": 50.076
  },
  {
    "text": "第五，坚持全面依法治国，在法治轨道上深化改革。",
    "start": 50.077,
    "end": 55.243
  },
  {
    "text": "第六，坚持系统观念，增强改革的系统性，整体性，协同性。",
    "start": 55.242,
    "end": 61.02
  },
  {
    "text": "改革要以经济体制改革为牵引，以促进社会公平正义。",
    "start": 61.02,
    "end": 66.173
  },
  {
    "text": "增进人民福祉为出发点和落脚点。",
    "start": 66.173,
    "end": 69.681
  },
  {
    "text": "考场大题核心采分点。",
    "start": 69.681,
    "end": 72.155
  },
  {
    "text": "改革开放是决定中国命运的关键一招，总目标两句话。",
    "start": 72.155,
    "end": 77.257
  },
  {
    "text": "制度主线与系统观念是答题亮点。",
    "start": 77.258,
    "end": 80.574
  },
  {
    "text": "深化改革关键招，治理现代绘宏图，守正创新制度主，公平正义惠民庐。",
    "start": 80.574,
    "end": 87.589
  }
]