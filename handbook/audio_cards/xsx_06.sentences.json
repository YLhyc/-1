[
  {
    "text": "文化兴则国运兴，文化强则民族强。",
    "start": 0.1,
    "end": 4.055
  },
  {
    "text": "在新时代。",
    "start": 4.005,
    "end": 5.459
  },
  {
    "text": "建设社会主义文化强国必须坚持马克思主义在意识形态领域指导地位的根本制度。",
    "start": 5.459,
    "end": 12.895
  },
  {
    "text": "习近平总书记深刻阐述了两个结合，特别是第二个结合。",
    "start": 12.895,
    "end": 18.035
  },
  {
    "text": "坚持把马克思主义基本原理同中华优秀传统文化相结合。",
    "start": 18.036,
    "end": 23.431
  },
  {
    "text": "第二个结合是又一次思想解放。",
    "start": 23.431,
    "end": 26.594
  },
  {
    "text": "它表明我们党对中国道路，理论，制度的认识达到了新高度。",
    "start": 26.594,
    "end": 32.181
  },
  {
    "text": "表明我们党的历史自信，文化自信达到了新高度。",
    "start": 32.181,
    "end": 36.76
  },
  {
    "text": "中华优秀传统文化是中华文明的智慧结晶，是中华民族的根和魂。",
    "start": 36.76,
    "end": 43.048
  },
  {
    "text": "推进文化繁荣，必须坚持创造性转化，创新性发展。",
    "start": 43.048,
    "end": 48.074
  },
  {
    "text": "激发全民族文化创新创造活力，增强实现中华民族伟大复兴的精神力量。",
    "start": 48.074,
    "end": 54.668
  },
  {
    "text": "意识形态关乎旗帜，关乎道路，关乎国家政治安全。",
    "start": 54.668,
    "end": 59.68
  },
  {
    "text": "必须牢牢掌握党对意识形态工作的领导权。",
    "start": 59.681,
    "end": 63.686
  },
  {
    "text": "建设具有强大凝聚力和引领力的社会主义意识形态。",
    "start": 63.686,
    "end": 68.367
  },
  {
    "text": "考场题眼。",
    "start": 68.367,
    "end": 69.821
  },
  {
    "text": "第二个结合是又一次思想解放，意识形态决定文化前进方向和道路。",
    "start": 69.821,
    "end": 76.045
  },
  {
    "text": "两结同心显自信，传统转化赋新神，牢抓意识领导权，文化强国铸灵魂。",
    "start": 76.046,
    "end": 83.316
  }
]