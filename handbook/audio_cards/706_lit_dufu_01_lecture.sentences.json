[
  {
    "id": 1,
    "text": "杜甫“诗史”论述题的内部逻辑展开，遵循“总论定位、史实认知、心灵深化、文体革新、总论收束”五层递进。",
    "start": 0.1,
    "end": 10.0,
    "duration": 9.9
  },
  {
    "id": 2,
    "text": "首先看开篇总论。",
    "start": 9.95,
    "end": 12.037,
    "duration": 2.087
  },
  {
    "id": 3,
    "text": "很多考生将“诗史”简单等同于“用诗歌记录历史”，这是浅层理解。",
    "start": 12.037,
    "end": 17.825,
    "duration": 5.788
  },
  {
    "id": 4,
    "text": "开篇必须从三个维度综合定性：严肃的史家眼光、博大的儒家仁爱，以及叙事诗学的突破。",
    "start": 17.825,
    "end": 26.25,
    "duration": 8.425
  },
  {
    "id": 5,
    "text": "这样定性，为后续三个分论点确立了逻辑总纲。",
    "start": 26.25,
    "end": 30.988,
    "duration": 4.738
  },
  {
    "id": 6,
    "text": "进入第一层：史实认识价值。",
    "start": 30.988,
    "end": 34.125,
    "duration": 3.137
  },
  {
    "id": 7,
    "text": "这是“诗史”的外在客观基础。",
    "start": 34.125,
    "end": 36.9,
    "duration": 2.775
  },
  {
    "id": 8,
    "text": "答题首先要证明杜诗具有历史真确性与时事敏锐度。",
    "start": 36.9,
    "end": 42.1,
    "duration": 5.2
  },
  {
    "id": 9,
    "text": "悲陈陶》《收京三首》《洗兵马》按战局顺次展开，更以“三吏三别”记录严酷征兵。",
    "start": 42.1,
    "end": 49.825,
    "duration": 7.725
  },
  {
    "id": 10,
    "text": "此处核心踩分点是“补史之缺”。",
    "start": 49.825,
    "end": 52.825,
    "duration": 3.0
  },
  {
    "id": 11,
    "text": "例如《三绝句》补正史未载之杀刺史事，体现出高度自觉的存史意识。",
    "start": 52.825,
    "end": 59.475,
    "duration": 6.65
  },
  {
    "id": 12,
    "text": "接下来，从第一层向第二层递进：生活画面的深度与广度。",
    "start": 59.475,
    "end": 64.875,
    "duration": 5.4
  },
  {
    "id": 13,
    "text": "这一步是答题深度的关键跨越，回答了“诗歌为什么能超越正史”。",
    "start": 64.875,
    "end": 70.612,
    "duration": 5.737
  },
  {
    "id": 14,
    "text": "正史通常局限于帝王将相与战局得失，是宏观而抽象的骨架。",
    "start": 70.612,
    "end": 76.65,
    "duration": 6.038
  },
  {
    "id": 15,
    "text": "杜诗的独特价值，在于以一人一家见一代一国，把时代浩劫转化为具体的人性震颤。",
    "start": 76.65,
    "end": 84.862,
    "duration": 8.212
  },
  {
    "id": 16,
    "text": "通过《五百字》的阶级反差、《无家别》的家破人亡、《又呈吴郎》的底层关照。",
    "start": 84.862,
    "end": 91.175,
    "duration": 6.313
  },
  {
    "id": 17,
    "text": "杜诗记录的不仅是客观历史，更是战争下整个民族的心灵史。",
    "start": 91.175,
    "end": 97.112,
    "duration": 5.937
  },
  {
    "id": 18,
    "text": "第三层：写作方法的诗学转变。",
    "start": 97.112,
    "end": 100.412,
    "duration": 3.3
  },
  {
    "id": 19,
    "text": "这一层解答了“宏大现实如何转化为文学艺术”。",
    "start": 100.412,
    "end": 104.938,
    "duration": 4.526
  },
  {
    "id": 20,
    "text": "盛唐诗歌以空灵神韵与玲珑兴象为主，无法承载沉重复杂的人间苦难。",
    "start": 104.938,
    "end": 112.0,
    "duration": 7.062
  },
  {
    "id": 21,
    "text": "杜甫以即事名篇的叙事手法突破了传统抒情体制，把五七言古体与律诗推向叙事高峰。",
    "start": 112.0,
    "end": 120.4,
    "duration": 8.4
  },
  {
    "id": 22,
    "text": "通过“叙事抒情化”与“抒情叙事化”的融合，开启了中唐新乐府运动的法门。",
    "start": 120.4,
    "end": 126.95,
    "duration": 6.55
  },
  {
    "id": 23,
    "text": "最后看结尾收束。",
    "start": 126.95,
    "end": 129.113,
    "duration": 2.163
  },
  {
    "id": 24,
    "text": "总结段并非机械重复前文，而是将史实真确性、博大人民性与叙事独创性三者统合。",
    "start": 129.113,
    "end": 137.562,
    "duration": 8.449
  },
  {
    "id": 25,
    "text": "引用元稹“尽得古今之体势，而兼人人之所独专”，完成文学史地位的学术定型。",
    "start": 137.562,
    "end": 144.95,
    "duration": 7.388
  },
  {
    "id": 26,
    "text": "掌握这条从外部史实、到内心现实、再到诗学体制的递进因果链，答题便能浑然一体。",
    "start": 144.95,
    "end": 153.613,
    "duration": 8.663
  }
]