[
  {
    "text": "面对世界百年未有之大变局，中国给出了明确的中国方案。",
    "start": 0.1,
    "end": 5.241
  },
  {
    "text": "推动构建人类命运共同体。",
    "start": 5.191,
    "end": 7.921
  },
  {
    "text": "构建人类命运共同体是当代中国外交的核心理念，指明了世界历史发展的正确方向。",
    "start": 7.921,
    "end": 15.549
  },
  {
    "text": "人类命运共同体的核心内涵是。",
    "start": 15.548,
    "end": 18.52
  },
  {
    "text": "建设持久和平，普遍安全，共同繁荣，开放包容，清洁美丽的世界。",
    "start": 18.52,
    "end": 24.859
  },
  {
    "text": "推动构建新型国际关系，坚持相互尊重，公平正义，合作共赢。",
    "start": 24.86,
    "end": 31.11
  },
  {
    "text": "中国始终坚持独立自主的和平外交政策，坚定不移走和平发展道路。",
    "start": 31.11,
    "end": 37.475
  },
  {
    "text": "共建一带一路是推动构建人类命运共同体的重大实践平台，坚持共商共建共享原则。",
    "start": 37.474,
    "end": 45.369
  },
  {
    "text": "践行真正的多边主义，提出全球发展倡议，全球安全倡议，全球文明倡议三大倡议。",
    "start": 45.37,
    "end": 53.278
  },
  {
    "text": "为破解人类发展安全文明赤字贡献了中国智慧。",
    "start": 53.278,
    "end": 57.793
  },
  {
    "text": "考场大题核心采分点。",
    "start": 57.793,
    "end": 60.267
  },
  {
    "text": "构建人类命运共同体五个世界目标，新型国际关系十二字原则。",
    "start": 60.268,
    "end": 66.097
  },
  {
    "text": "一带一路共商共建共享。",
    "start": 66.097,
    "end": 68.776
  },
  {
    "text": "大变局中起宏图，命运与共济同舟，一带一路展合作，三大倡议解世愁。",
    "start": 68.776,
    "end": 75.689
  }
]