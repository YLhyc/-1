[
  {
    "text": "进入历史新时期，中国共产党成功开辟了中国特色社会主义道路。",
    "start": 0.1,
    "end": 6.147
  },
  {
    "text": "形成了中国特色社会主义理论体系。",
    "start": 6.097,
    "end": 9.337
  },
  {
    "text": "中特理论体系包括邓小平理论，三个代表重要思想，科学发展观。",
    "start": 9.337,
    "end": 15.574
  },
  {
    "text": "以及习近平新时代中国特色社会主义思想。",
    "start": 15.574,
    "end": 19.656
  },
  {
    "text": "中国特色社会主义理论体系的创立。",
    "start": 19.656,
    "end": 22.858
  },
  {
    "text": "紧紧围绕着建设中国特色社会主义这一历史主题。",
    "start": 22.857,
    "end": 27.589
  },
  {
    "text": "从邓小平在党的十二大开幕词中提出走自己的道路，建设有中国特色的社会主义。",
    "start": 27.589,
    "end": 34.987
  },
  {
    "text": "到改革开放四十多年的波澜壮阔实践。",
    "start": 34.987,
    "end": 38.533
  },
  {
    "text": "中特理论体系回答了社会主义初级阶段中国发展的重大时代课题。",
    "start": 38.533,
    "end": 44.439
  },
  {
    "text": "它是马克思主义中国化时代化的又一次伟大飞跃。",
    "start": 44.439,
    "end": 48.712
  },
  {
    "text": "是指引全党和全国人民实现中华民族伟大复兴的行动指南。",
    "start": 48.712,
    "end": 54.171
  },
  {
    "text": "考场审题辨析。",
    "start": 54.171,
    "end": 56.123
  },
  {
    "text": "毛泽东思想不属于中国特色社会主义理论体系，毛泽东思想是第一次飞跃。",
    "start": 56.122,
    "end": 62.627
  },
  {
    "text": "而中特理论体系始于邓小平理论，切忌在选择题中将两者归属混淆。",
    "start": 62.628,
    "end": 69.21
  },
  {
    "text": "走自己的路开新篇，中国特色迎潮立，十二大上擂战鼓，理论体系耀古今。",
    "start": 69.209,
    "end": 76.275
  }
]