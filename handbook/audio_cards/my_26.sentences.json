[
  {
    "text": "认识的最终追求是真理，真理究竟具备怎样的特质。",
    "start": 0.1,
    "end": 4.859
  },
  {
    "text": "真理是标志主观与客观相符合的哲学范畴，是对客观事物及其规律的正确反映。",
    "start": 4.809,
    "end": 11.786
  },
  {
    "text": "真理的第一属性是客观性，承认真理的客观性就是坚持唯物主义认识论。",
    "start": 11.786,
    "end": 18.01
  },
  {
    "text": "真理内容的客观性体现在。",
    "start": 18.01,
    "end": 20.625
  },
  {
    "text": "真理所反映的内容是客观的，检验真理的标准也是客观的实践。",
    "start": 20.625,
    "end": 26.071
  },
  {
    "text": "真理又包含绝对性和相对性，这是同一真理的两种不同属性。",
    "start": 26.071,
    "end": 31.734
  },
  {
    "text": "真理的绝对性是指。",
    "start": 31.735,
    "end": 33.801
  },
  {
    "text": "任何真理都包含着同客观对象相符合的客观内容。",
    "start": 33.801,
    "end": 38.865
  },
  {
    "text": "人类认识按其本性能够正确认识无限的世界。",
    "start": 38.865,
    "end": 43.151
  },
  {
    "text": "真理的相对性是指。",
    "start": 43.151,
    "end": 45.243
  },
  {
    "text": "任何真理都是对客观世界某一部分，某一片断的正确反映。",
    "start": 45.242,
    "end": 50.446
  },
  {
    "text": "广度和深度都是有条件的。",
    "start": 50.446,
    "end": 53.176
  },
  {
    "text": "绝对真理和相对真理相互包含，相互贯通。",
    "start": 53.176,
    "end": 57.398
  },
  {
    "text": "无数相对真理的总和构成了绝对真理。",
    "start": 57.398,
    "end": 61.02
  },
  {
    "text": "真理的发展是一个由相对走向绝对的无止境过程。",
    "start": 61.02,
    "end": 65.561
  },
  {
    "text": "考场避坑重点。",
    "start": 65.561,
    "end": 67.487
  },
  {
    "text": "真理与谬误在一定范围内是对立的，但超出一定范围，真理就会变成谬误。",
    "start": 67.487,
    "end": 74.12
  },
  {
    "text": "真理绝不是绝对不变的教条，必须随着实践的发展而发展。",
    "start": 74.12,
    "end": 79.273
  },
  {
    "text": "内容客观是根基，绝对相对相交织，真谬相依有界限，与时俱进求真知。",
    "start": 79.273,
    "end": 86.339
  }
]