[
  {
    "text": "理想信念是人生的精神支柱和力量源泉。",
    "start": 0.1,
    "end": 4.399
  },
  {
    "text": "理想是人们在实践中形成的，有实现可能性的。",
    "start": 4.349,
    "end": 8.392
  },
  {
    "text": "对未来社会和自身发展的向往与追求。",
    "start": 8.393,
    "end": 12.117
  },
  {
    "text": "理想具有时代性，实践性和阶级性。",
    "start": 12.117,
    "end": 15.854
  },
  {
    "text": "信念是认知，情感和意志的有机统一体。",
    "start": 15.855,
    "end": 19.796
  },
  {
    "text": "是人们在一定的认识基础上确立的对某种思想或事物坚信不疑的心理态度。",
    "start": 19.796,
    "end": 26.875
  },
  {
    "text": "理想与信念紧密相连，理想是信念的指路明灯，信念是理想的坚实后盾。",
    "start": 26.875,
    "end": 33.686
  },
  {
    "text": "理想信念对人生的巨大作用体现在三个方面。",
    "start": 33.686,
    "end": 37.959
  },
  {
    "text": "第一，昭示奋斗目标，指引人生的前进方向。",
    "start": 37.959,
    "end": 42.245
  },
  {
    "text": "第二，提供前进动力，激发人生的顽强拼搏精神。",
    "start": 42.245,
    "end": 46.913
  },
  {
    "text": "第三，提高精神境界，塑造高尚的道德品格和崇高追求。",
    "start": 46.913,
    "end": 52.717
  },
  {
    "text": "正如习近平总书记所指出的，理想信念就是共产党人精神上的钙，没有理想信念。",
    "start": 52.717,
    "end": 60.026
  },
  {
    "text": "理想信念不坚定，精神上就会缺钙，就会得软骨病。",
    "start": 60.026,
    "end": 64.758
  },
  {
    "text": "考场大题核心题眼。",
    "start": 64.758,
    "end": 67.028
  },
  {
    "text": "理想信念是精神上的钙，提供奋斗目标与精神动力。",
    "start": 67.028,
    "end": 72.092
  },
  {
    "text": "向往未来是理想，坚信不移筑信念，精神之钙铸风骨，劈波斩浪向前看。",
    "start": 72.092,
    "end": 78.801
  }
]