[
  {
    "text": "生态兴则文明兴，生态衰则文明衰。",
    "start": 0.1,
    "end": 4.081
  },
  {
    "text": "绿水青山就是金山银山，是习近平生态文明思想的核心理念。",
    "start": 4.031,
    "end": 9.847
  },
  {
    "text": "这一理念深刻揭示了保护生态环境就是保护生产力。",
    "start": 9.847,
    "end": 14.617
  },
  {
    "text": "改善生态环境就是发展生产力的辩证哲理。",
    "start": 14.617,
    "end": 18.762
  },
  {
    "text": "推进美丽中国建设，必须牢固树立尊重自然，顺应自然，保护自然的生态文明理念。",
    "start": 18.763,
    "end": 26.352
  },
  {
    "text": "坚持人与自然和谐共生，走生产发展，生活富裕，生态良好的文明发展道路。",
    "start": 26.352,
    "end": 33.52
  },
  {
    "text": "建设美丽中国的重大战略举措包括。",
    "start": 33.52,
    "end": 36.926
  },
  {
    "text": "第一，加快发展方式绿色转型，协同推进降碳，减污，扩绿，增长。",
    "start": 36.926,
    "end": 43.712
  },
  {
    "text": "第二，深入打好蓝天，碧水，净土保卫战，持续深入推进污染防治攻坚。",
    "start": 43.712,
    "end": 50.715
  },
  {
    "text": "第三，提升生态系统多样性，稳定性，持续性，加大生态系统保护力度。",
    "start": 50.714,
    "end": 57.461
  },
  {
    "text": "第四，积极稳妥推进碳达峰碳中和，立足我国能源资源禀赋，坚持先立后破。",
    "start": 57.462,
    "end": 65.013
  },
  {
    "text": "考场大题核心采分点。",
    "start": 65.013,
    "end": 67.487
  },
  {
    "text": "人与自然是生命共同体，保护生态就是保护生产力，双碳工作坚持先立后破。",
    "start": 67.487,
    "end": 74.936
  },
  {
    "text": "两山理念指千秋，人与自然共命留，绿色转型降碳污，美丽中国展画轴。",
    "start": 74.936,
    "end": 81.773
  }
]