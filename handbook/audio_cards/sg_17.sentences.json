[
  {
    "text": "在解放战争胜利推进的同时，国统区和解放区发生着深刻的社会变革。",
    "start": 0.1,
    "end": 6.555
  },
  {
    "text": "在解放区，党开展了轰轰烈烈的土地制度改革。",
    "start": 6.505,
    "end": 10.906
  },
  {
    "text": "1946年中共中央发出五四指示，把减租减息政策改为没收地主土地分配给农民。",
    "start": 10.906,
    "end": 18.954
  },
  {
    "text": "1947年颁布《中国土地法大纲》，明确废除封建土地剥削制度。",
    "start": 18.954,
    "end": 24.783
  },
  {
    "text": "实行耕者有其田。",
    "start": 24.783,
    "end": 26.862
  },
  {
    "text": "土地改革从根本上摧毁了封建剥削制度，激发了亿万农民的革命积极性。",
    "start": 26.862,
    "end": 33.482
  },
  {
    "text": "为解放战争胜利提供了源源不断的人力物力支持。",
    "start": 33.482,
    "end": 38.074
  },
  {
    "text": "在国统区，国民党反动统治导致经济崩溃，民不聊生。",
    "start": 38.074,
    "end": 43.316
  },
  {
    "text": "在共产党领导下，以学生运动为先导，广大工人市民参加的爱国民主运动蓬勃兴起。",
    "start": 43.316,
    "end": 50.79
  },
  {
    "text": "形成了反对国民党反动统治的第二条战线。",
    "start": 50.791,
    "end": 54.618
  },
  {
    "text": "两条战线相互呼应，陷蒋介石政权于全民灭亡的汪洋大海之中。",
    "start": 54.617,
    "end": 60.727
  },
  {
    "text": "考场题眼。",
    "start": 60.727,
    "end": 62.181
  },
  {
    "text": "五四指示减租减息变没收土地，土地法大纲耕者有其田。",
    "start": 62.181,
    "end": 68.099
  },
  {
    "text": "国统区爱国运动构成第二条战线。",
    "start": 68.099,
    "end": 71.326
  },
  {
    "text": "五四指示改地政，耕者有田民心齐，国统区内风雷动，第二战线斩敌旗。",
    "start": 71.327,
    "end": 77.909
  }
]