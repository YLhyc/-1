[
  {
    "text": "在确立了革命总路线之后，新民主主义的基本纲领指明了具体的制度蓝图。",
    "start": 0.1,
    "end": 6.657
  },
  {
    "text": "新民主主义纲领包含政治，经济和文化三大方面。",
    "start": 6.607,
    "end": 11.569
  },
  {
    "text": "第一，政治纲领。",
    "start": 11.569,
    "end": 13.508
  },
  {
    "text": "推翻帝国主义和封建主义的统治，建立无产阶级领导的。",
    "start": 13.508,
    "end": 18.585
  },
  {
    "text": "以工农联盟为基础的各革命阶级联合专政的新民主主义共和国。",
    "start": 18.584,
    "end": 24.451
  },
  {
    "text": "国体是各革命阶级联合专政，政体是民主集中制的人民代表大会制度。",
    "start": 24.452,
    "end": 30.804
  },
  {
    "text": "第二，经济纲领。",
    "start": 30.804,
    "end": 32.794
  },
  {
    "text": "包含著名的三大原则。",
    "start": 32.793,
    "end": 35.191
  },
  {
    "text": "没收封建地主阶级的土地归农民所有，这是新民主主义革命的主要内容。",
    "start": 35.191,
    "end": 41.862
  },
  {
    "text": "没收官僚垄断资本归新民主主义国家所有。",
    "start": 41.862,
    "end": 46.109
  },
  {
    "text": "这兼具民主革命和社会主义革命的双重性质。",
    "start": 46.11,
    "end": 50.587
  },
  {
    "text": "保护民族工商业，这是极具中国特色的经济政策。",
    "start": 50.587,
    "end": 55.141
  },
  {
    "text": "第三，文化纲领。",
    "start": 55.14,
    "end": 57.257
  },
  {
    "text": "无产阶级领导的人民大众的反帝反封建文化，即民族的，科学的，大众的文化。",
    "start": 57.258,
    "end": 64.528
  },
  {
    "text": "民族的文化反对帝国主义压迫，科学的文化反对一切封建迷信。",
    "start": 64.528,
    "end": 70.523
  },
  {
    "text": "大众的文化为全民族最广大工农大众服务。",
    "start": 70.523,
    "end": 74.681
  },
  {
    "text": "考场选择题经典。",
    "start": 74.681,
    "end": 76.811
  },
  {
    "text": "没收官僚资本具有双重性质，既没收买办垄断资本反帝反封。",
    "start": 76.811,
    "end": 82.87
  },
  {
    "text": "又建立社会主义国营经济。",
    "start": 82.87,
    "end": 85.548
  },
  {
    "text": "联合专政定国体，土地农民官僚国，民族科学大众化，制度蓝图绘锦绣。",
    "start": 85.548,
    "end": 92.066
  }
]