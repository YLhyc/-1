[
  {
    "text": "党在社会主义建设道路初步探索中，既取得了重大成果，也遭遇了严重曲折。",
    "start": 0.1,
    "end": 6.951
  },
  {
    "text": "初步探索取得的重大理论成果包括。",
    "start": 6.901,
    "end": 10.485
  },
  {
    "text": "提出走中国工业化道路，提出社会主义发展阶段理论。",
    "start": 10.485,
    "end": 15.192
  },
  {
    "text": "指出社会主义分为不发达和比较发达两个阶段。",
    "start": 15.191,
    "end": 19.961
  },
  {
    "text": "提出四个现代化的奋斗目标，即现代工业，现代农业，现代国防和现代科学技术。",
    "start": 19.962,
    "end": 27.602
  },
  {
    "text": "提出经济体制改革的初步设想，比如陈云提出的三个主体，三个补充。",
    "start": 27.602,
    "end": 34.018
  },
  {
    "text": "同时也留下了沉痛的历史教训，主要是在阶级斗争扩大化。",
    "start": 34.018,
    "end": 39.248
  },
  {
    "text": "经济建设急于求成等方面犯了错误。",
    "start": 39.247,
    "end": 42.589
  },
  {
    "text": "初步探索的历史地位与重大意义。",
    "start": 42.589,
    "end": 45.906
  },
  {
    "text": "第一，巩固和发展了我国的社会主义制度。",
    "start": 45.906,
    "end": 49.643
  },
  {
    "text": "第二，为开创中国特色社会主义提供了宝贵经验，理论准备和物质基础。",
    "start": 49.643,
    "end": 56.39
  },
  {
    "text": "正是在总结初步探索正反两方面经验的基础上。",
    "start": 56.39,
    "end": 60.663
  },
  {
    "text": "邓小平理论和中国特色社会主义才得以成功开创。",
    "start": 60.663,
    "end": 65.51
  },
  {
    "text": "考场大题核心采分。",
    "start": 65.51,
    "end": 67.882
  },
  {
    "text": "改革开放前和改革开放后两个历史时期不能相互否定。",
    "start": 67.883,
    "end": 73.1
  },
  {
    "text": "前期探索为后期开创提供了不可或缺的前提基础。",
    "start": 73.099,
    "end": 78.086
  },
  {
    "text": "初步探索成果丰，四化目标指前程，宝贵经验奠基业，前后贯通鉴后人。",
    "start": 78.087,
    "end": 84.988
  }
]