[
  {
    "text": "资本家为了获取更多的剩余价值，主要采用两种基本方法。",
    "start": 0.1,
    "end": 5.178
  },
  {
    "text": "绝对剩余价值生产和相对剩余价值生产。",
    "start": 5.128,
    "end": 9.159
  },
  {
    "text": "绝对剩余价值生产，是指在必要劳动时间不变的条件下。",
    "start": 9.158,
    "end": 14.107
  },
  {
    "text": "通过绝对延长工作日长度或提高劳动强度而生产的剩余价值。",
    "start": 14.107,
    "end": 20.038
  },
  {
    "text": "由于生理极限和工人反抗，工作日不能无限延长。",
    "start": 20.038,
    "end": 24.566
  },
  {
    "text": "相对剩余价值生产，是指在工作日长度不变的条件下。",
    "start": 24.566,
    "end": 29.617
  },
  {
    "text": "通过缩短必要劳动时间而相对延长剩余劳动时间生产的剩余价值。",
    "start": 29.617,
    "end": 35.727
  },
  {
    "text": "缩短必要劳动时间的唯一途径，是降低劳动力的价值。",
    "start": 35.727,
    "end": 40.497
  },
  {
    "text": "而降低劳动力价值，就必须提高生产生活资料部门的劳动生产率。",
    "start": 40.497,
    "end": 46.556
  },
  {
    "text": "在现实中，资本家为了追求超额剩余价值而展开激烈竞争。",
    "start": 46.556,
    "end": 52.309
  },
  {
    "text": "超额剩余价值是个别资本家由于率先采用先进技术，提高个别劳动生产率。",
    "start": 52.309,
    "end": 59.069
  },
  {
    "text": "使个别价值低于社会价值而获得的剩余价值。",
    "start": 59.069,
    "end": 63.788
  },
  {
    "text": "全行业竞争的客观结果是社会生产率普遍提高，超额剩余价值消失。",
    "start": 63.788,
    "end": 70.153
  },
  {
    "text": "最终形成相对剩余价值。",
    "start": 70.153,
    "end": 72.857
  },
  {
    "text": "超额剩余价值是原因，相对剩余价值是结果。",
    "start": 72.857,
    "end": 77.194
  },
  {
    "text": "绝对延长时间轴，相对压缩必要期，个别追逐超额利，全网提效水落石。",
    "start": 77.194,
    "end": 83.814
  }
]