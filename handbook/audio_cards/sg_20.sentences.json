[
  {
    "text": "新中国诞生后，面对帝国主义的武装威胁，党毅然作出了抗美援朝。",
    "start": 0.1,
    "end": 6.249
  },
  {
    "text": "保家卫国的英明决策。",
    "start": 6.199,
    "end": 8.546
  },
  {
    "text": "中国人民志愿军跨过鸭绿江，同朝鲜军民并肩作战，打败了不可一世的侵略者。",
    "start": 8.546,
    "end": 15.689
  },
  {
    "text": "抗美援朝战争的胜利，打破了美帝国主义不可战胜的神话，顶住了侵略扩张。",
    "start": 15.689,
    "end": 22.385
  },
  {
    "text": "保卫了新中国安全，极大地提高了新中国的国际威望。",
    "start": 22.385,
    "end": 27.104
  },
  {
    "text": "在巩固政权的同时，党提出了过渡时期总路线，展开了有计划的社会主义经济建设。",
    "start": 27.105,
    "end": 34.171
  },
  {
    "text": "实施了第一个五年计划，一大批现代工业骨干项目相继建成。",
    "start": 34.171,
    "end": 39.885
  },
  {
    "text": "伴随着对农业，手工业和资本主义工商业社会主义改造的胜利完成。",
    "start": 39.885,
    "end": 46.02
  },
  {
    "text": "1954年第一届全国人民代表大会通过了第一部《中华人民共和国宪法》。",
    "start": 46.02,
    "end": 52.066
  },
  {
    "text": "确立了根本政治制度。",
    "start": 52.066,
    "end": 54.324
  },
  {
    "text": "1956年社会主义改造完成。",
    "start": 54.324,
    "end": 57.538
  },
  {
    "text": "标志着社会主义基本制度在我国确立，中国进入了社会主义初级阶段。",
    "start": 57.538,
    "end": 63.673
  },
  {
    "text": "考场大题核心题眼。",
    "start": 63.673,
    "end": 65.943
  },
  {
    "text": "抗美援朝是立国之战，一届人大确立人民代表大会根本制度。",
    "start": 65.944,
    "end": 71.518
  },
  {
    "text": "三大改造完成进入初级阶段。",
    "start": 71.518,
    "end": 74.566
  },
  {
    "text": "抗美援朝立国威，一五计划工业基，首部宪法保民主，初级阶段展宏图。",
    "start": 74.566,
    "end": 81.326
  }
]