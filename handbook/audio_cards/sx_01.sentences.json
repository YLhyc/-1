[
  {
    "text": "复习思修第一课，我们要探寻人生的总开关。",
    "start": 0.1,
    "end": 4.081
  },
  {
    "text": "人生观。",
    "start": 4.031,
    "end": 5.332
  },
  {
    "text": "人生观是人们在实践中形成的对于人生目的，人生态度。",
    "start": 5.332,
    "end": 10.421
  },
  {
    "text": "人生价值等问题的总观点和总看法。",
    "start": 10.421,
    "end": 14.005
  },
  {
    "text": "人生观由三个主要要素构成，三者紧密相连。",
    "start": 14.005,
    "end": 18.635
  },
  {
    "text": "第一，人生目的是人生观的核心。",
    "start": 18.635,
    "end": 21.786
  },
  {
    "text": "它回答人为什么活着，决定了人生的根本方向？",
    "start": 21.786,
    "end": 26.11
  },
  {
    "text": "决定了人生的态度和人生价值的评价尺度。",
    "start": 26.11,
    "end": 30.077
  },
  {
    "text": "第二，人生态度回答人应当怎样对待生活。",
    "start": 30.077,
    "end": 34.044
  },
  {
    "text": "它反映了人的精神状态和心理倾向，积极进取还是消极沉沦直接影响人生追求。",
    "start": 34.043,
    "end": 41.989
  },
  {
    "text": "第三，人生价值回答什么样的生活才有价值。",
    "start": 41.99,
    "end": 45.944
  },
  {
    "text": "它是人们对生活意义的评价标准，制约着人生目的和人生态度。",
    "start": 45.944,
    "end": 51.633
  },
  {
    "text": "世界观决定人生观，人生观又反过来影响和丰富世界观。",
    "start": 51.633,
    "end": 56.633
  },
  {
    "text": "马克思主义科学揭示了人的本质。",
    "start": 56.633,
    "end": 59.911
  },
  {
    "text": "人的本质不是单个人所固有的抽象物，在其现实性上，它是一切社会关系的总和。",
    "start": 59.911,
    "end": 66.824
  },
  {
    "text": "这就从根本上击碎了抽象人性论，指明人是社会的人。",
    "start": 66.824,
    "end": 72.219
  },
  {
    "text": "人生价值必须在社会关系中去实现。",
    "start": 72.219,
    "end": 75.739
  },
  {
    "text": "考场避坑。",
    "start": 75.74,
    "end": 77.309
  },
  {
    "text": "人生观的核心是人生目的，人的本质是一切社会关系的总和。",
    "start": 77.309,
    "end": 82.972
  },
  {
    "text": "目的核心定方向，态度映照精神芒，社会关系显本质，人生三维谱华章。",
    "start": 82.972,
    "end": 89.783
  }
]