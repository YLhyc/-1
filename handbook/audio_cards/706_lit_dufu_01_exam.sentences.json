[
  {
    "id": 1,
    "text": "杜甫诗歌被后人誉为“诗史”，是唐代诗歌从盛唐走向中唐转变的伟大转折。",
    "start": 0.1,
    "end": 6.925,
    "duration": 6.825
  },
  {
    "id": 2,
    "text": "诗史”的性质与意义，并不在于对历史事件的简单编年罗列。",
    "start": 6.875,
    "end": 12.2,
    "duration": 5.325
  },
  {
    "id": 3,
    "text": "而在于以史家的严肃眼光、儒家的仁爱精神与叙事诗学的创造性突破。",
    "start": 12.2,
    "end": 18.812,
    "duration": 6.612
  },
  {
    "id": 4,
    "text": "生动展现了比史实更深广的生活画面与时代心灵史。",
    "start": 18.812,
    "end": 23.587,
    "duration": 4.775
  },
  {
    "id": 5,
    "text": "具体而言，杜甫“诗史”的内涵与价值体现在以下三个核心维度。",
    "start": 23.587,
    "end": 28.863,
    "duration": 5.276
  },
  {
    "id": 6,
    "text": "第一，从历史认识价值来看，杜诗以空前广阔的视野记录历史，更具有补史之缺的重要功能。",
    "start": 28.863,
    "end": 36.775,
    "duration": 7.912
  },
  {
    "id": 7,
    "text": "杜甫以极高的历史自觉即事名篇，全面反映了安史之乱前后的重大战局与社会转折。",
    "start": 36.775,
    "end": 44.525,
    "duration": 7.75
  },
  {
    "id": 8,
    "text": "例如《悲陈陶》《悲青坂》反映陈陶斜战役的大败。",
    "start": 44.525,
    "end": 49.05,
    "duration": 4.525
  },
  {
    "id": 9,
    "text": "收京三首》记录唐军收复长安与洛阳的历史时刻。",
    "start": 49.05,
    "end": 53.612,
    "duration": 4.562
  },
  {
    "id": 10,
    "text": "洗兵马》再现九节度兵围邺城的宏阔进军。",
    "start": 53.612,
    "end": 57.712,
    "duration": 4.1
  },
  {
    "id": 11,
    "text": "而著名的“三吏三别”则深刻记录了战争溃败之后的严酷征兵与民间浩劫。",
    "start": 57.712,
    "end": 64.537,
    "duration": 6.825
  },
  {
    "id": 12,
    "text": "更为重要的是，杜诗能够补正史所未载。",
    "start": 64.537,
    "end": 68.213,
    "duration": 3.676
  },
  {
    "id": 13,
    "text": "如《三绝句》中所记录的渝州、开州杀刺史事件，正史无闻而杜诗存之。",
    "start": 68.213,
    "end": 74.838,
    "duration": 6.625
  },
  {
    "id": 14,
    "text": "这表明杜甫不仅具有高度敏锐的时事感知，更具备了史官般的存史意识。",
    "start": 74.838,
    "end": 81.138,
    "duration": 6.3
  },
  {
    "id": 15,
    "text": "第二，从反映生活的广度与深度来看，杜诗提供了比正史更具体、更震撼的生活图景与心灵画卷。",
    "start": 81.138,
    "end": 90.188,
    "duration": 9.05
  },
  {
    "id": 16,
    "text": "正史往往局限于帝王将相的政治谋略与城池得失。",
    "start": 90.188,
    "end": 94.662,
    "duration": 4.474
  },
  {
    "id": 17,
    "text": "而杜甫则将笔触深沉地投向普通民众与下层百姓的生死苦难。",
    "start": 94.662,
    "end": 100.562,
    "duration": 5.9
  },
  {
    "id": 18,
    "text": "他善于“以一人一家见一代一国”，把浩大战火压缩进个人的心灵遭遇之中。",
    "start": 100.562,
    "end": 107.125,
    "duration": 6.563
  },
  {
    "id": 19,
    "text": "自京赴奉先县咏怀五百字》写出“朱门酒肉臭，路有冻死骨”的悬殊阶级反差。",
    "start": 107.125,
    "end": 113.987,
    "duration": 6.862
  },
  {
    "id": 20,
    "text": "无家别》写故乡荒芜、老母病殁、还乡无家而复被驱赶从军的绝境。",
    "start": 113.987,
    "end": 120.025,
    "duration": 6.038
  },
  {
    "id": 21,
    "text": "又呈吴郎》写贫困寡妇扑枣维生的微末之态，充满仁者爱人的人性关照。",
    "start": 120.025,
    "end": 126.237,
    "duration": 6.212
  },
  {
    "id": 22,
    "text": "杜诗把动荡岁月中人民的血泪与内心震颤完全展开。",
    "start": 126.237,
    "end": 131.238,
    "duration": 5.001
  },
  {
    "id": 23,
    "text": "使“诗史”升华为一部真实可感、直击灵魂的民族受难心灵史。",
    "start": 131.238,
    "end": 136.4,
    "duration": 5.162
  },
  {
    "id": 24,
    "text": "第三，从文学写作方法的转变来看，杜甫实现了唐诗抒情传统向现实主义叙事传统的划时代跨越。",
    "start": 136.4,
    "end": 145.188,
    "duration": 8.788
  },
  {
    "id": 25,
    "text": "盛唐诗歌多偏重于营造空灵神韵与玲珑兴象。",
    "start": 145.188,
    "end": 149.713,
    "duration": 4.525
  },
  {
    "id": 26,
    "text": "而杜甫则融铸五七言古体与律诗，开辟了即事名篇、以叙事手法书写时事的新高峰。",
    "start": 149.713,
    "end": 157.9,
    "duration": 8.187
  },
  {
    "id": 27,
    "text": "杜甫的大量叙事诗，情节跌宕起伏，人物对白传神，心理刻画深微入骨。",
    "start": 157.9,
    "end": 164.475,
    "duration": 6.575
  },
  {
    "id": 28,
    "text": "完美达成了“叙事抒情化”与“抒情叙事化”的浑融一体。",
    "start": 164.475,
    "end": 168.738,
    "duration": 4.263
  },
  {
    "id": 29,
    "text": "这一诗学范式的开拓，直接启发了中唐元稹、白居易的新乐府运动。",
    "start": 168.738,
    "end": 174.438,
    "duration": 5.7
  },
  {
    "id": 30,
    "text": "成为唐代乃至后世现实主义诗歌发展的根本法门。",
    "start": 174.438,
    "end": 178.912,
    "duration": 4.474
  },
  {
    "id": 31,
    "text": "综上所述，杜甫的“诗史”具有深厚的历史真确性、博大的人民性与杰出的艺术独创性。",
    "start": 178.912,
    "end": 186.338,
    "duration": 7.426
  },
  {
    "id": 32,
    "text": "它既是盛唐气度与儒家忧患意识的终极熔铸。",
    "start": 186.338,
    "end": 190.512,
    "duration": 4.174
  },
  {
    "id": 33,
    "text": "又是古典诗歌关注苍生疾苦的最高典范。",
    "start": 190.512,
    "end": 194.525,
    "duration": 4.013
  },
  {
    "id": 34,
    "text": "正如元稹所论“尽得古今之体势，而兼人人之所独专”，在文学史上放射出永恒的光芒。",
    "start": 194.525,
    "end": 202.312,
    "duration": 7.787
  }
]