[
  {
    "text": "1948年秋到1949年初，战略决战的时机成熟。",
    "start": 0.1,
    "end": 5.05
  },
  {
    "text": "人民解放军连续发动了辽沈战役，淮海战役，平津战役三大战役。",
    "start": 5.0,
    "end": 11.097
  },
  {
    "text": "三大战役基本消灭了国民党赖以维持反动统治的主要军事力量。",
    "start": 11.097,
    "end": 16.709
  },
  {
    "text": "在全国胜利即将来临的前夜。",
    "start": 16.709,
    "end": 19.566
  },
  {
    "text": "1949年3月党中央在西柏坡召开了中共七届二中全会。",
    "start": 19.566,
    "end": 25.127
  },
  {
    "text": "七届二中全会绘制了新中国的宏伟蓝图。",
    "start": 25.128,
    "end": 29.146
  },
  {
    "text": "确立了党的工作重心由乡村转移到城市。",
    "start": 29.145,
    "end": 33.29
  },
  {
    "text": "阐明了新中国的经济构成和向社会主义转变的前途。",
    "start": 33.291,
    "end": 38.253
  },
  {
    "text": "毛泽东在会上语重心长地告诫全党，务必使同志们继续地保持谦虚，谨慎，不骄。",
    "start": 38.253,
    "end": 45.995
  },
  {
    "text": "不躁的作风。",
    "start": 45.995,
    "end": 47.551
  },
  {
    "text": "务必使同志们继续地保持艰苦奋斗的作风，这就是著名的两个务必。",
    "start": 47.551,
    "end": 53.342
  },
  {
    "text": "党中央从西柏坡进京赶考，开启了建设新中国的伟大征程。",
    "start": 53.342,
    "end": 58.903
  },
  {
    "text": "考场大题核心题眼。",
    "start": 58.903,
    "end": 61.173
  },
  {
    "text": "七届二中全会实现工作重心由农村向城市转移，提出两个务必以防糖衣炮弹。",
    "start": 61.173,
    "end": 68.711
  },
  {
    "text": "三大战役摧枯拉，西柏坡前绘制宏，两个务必防蜕变，进京赶考铸丰功。",
    "start": 68.712,
    "end": 75.408
  }
]