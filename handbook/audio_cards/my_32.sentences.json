[
  {
    "text": "人类社会发展的第二条基本矛盾规律，是经济基础与上层建筑的辩证关系规律。",
    "start": 0.1,
    "end": 7.167
  },
  {
    "text": "经济基础是由社会一定发展阶段的生产力所决定的生产关系的总和。",
    "start": 7.117,
    "end": 13.15
  },
  {
    "text": "上层建筑是建立在一定经济基础之上的意识形态以及相应的政治法律制度和设施。",
    "start": 13.151,
    "end": 20.345
  },
  {
    "text": "上层建筑包含两大组成部分。",
    "start": 20.344,
    "end": 23.354
  },
  {
    "text": "第一，观念上层建筑，又叫意识形态，包括政治法律思想，道德，艺术，宗教。",
    "start": 23.355,
    "end": 30.817
  },
  {
    "text": "哲学等。",
    "start": 30.816,
    "end": 32.053
  },
  {
    "text": "第二，政治上层建筑，包括国家政权，军队，警察，法庭。",
    "start": 32.054,
    "end": 37.807
  },
  {
    "text": "监狱等国家机器和政治组织。",
    "start": 37.806,
    "end": 40.829
  },
  {
    "text": "政治上层建筑居于主导地位，国家政权是政治上层建筑的核心。",
    "start": 40.829,
    "end": 46.862
  },
  {
    "text": "两者的辩证关系。",
    "start": 46.862,
    "end": 48.814
  },
  {
    "text": "经济基础决定上层建筑，上层建筑反作用于经济基础。",
    "start": 48.814,
    "end": 54.031
  },
  {
    "text": "当上层建筑适合先进的经济基础时，就促进经济和社会的发展。",
    "start": 54.031,
    "end": 60.434
  },
  {
    "text": "考场核心避坑。",
    "start": 60.434,
    "end": 62.398
  },
  {
    "text": "生产力与生产关系，经济基础与上层建筑这两对矛盾，构成了人类社会的基本矛盾。",
    "start": 62.398,
    "end": 69.783
  },
  {
    "text": "推动政治体制改革，推进国家治理体系和治理能力现代化。",
    "start": 69.783,
    "end": 75.268
  },
  {
    "text": "本质上就是调整上层建筑以适应经济基础。",
    "start": 75.268,
    "end": 79.49
  },
  {
    "text": "经济基础总关系，政权核心筑高台，适应先进促发展，良法善治开盛宴。",
    "start": 79.49,
    "end": 86.518
  }
]