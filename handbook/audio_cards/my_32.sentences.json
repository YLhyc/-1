[
  {
    "text": "第32考点：经济基础与上层建筑的辩证关系及其矛盾运动规律。",
    "start": 0.1,
    "end": 6.339
  },
  {
    "text": "核心采分金句：经济基础是由一定发展阶段的生产力所决定的生产关系的总和。",
    "start": 6.289,
    "end": 13.49
  },
  {
    "text": "上层建筑是建立在经济基础之上的意识形态及与之相适应的制度组织和设施。",
    "start": 13.49,
    "end": 20.43
  },
  {
    "text": "经济基础决定上层建筑，上层建筑反作用于经济基础。",
    "start": 20.43,
    "end": 25.756
  },
  {
    "text": "要点深度拆解。",
    "start": 25.755,
    "end": 27.708
  },
  {
    "text": "第一，【经济基础与上层建筑的概念内涵】。",
    "start": 27.708,
    "end": 31.836
  },
  {
    "text": "经济基础即占统治地位的生产关系各方面的总和。",
    "start": 31.836,
    "end": 36.745
  },
  {
    "text": "上层建筑包括观念上层建筑（意识形态）和政治上层建筑（国家政权，军队，警察，法庭等）。",
    "start": 36.745,
    "end": 45.482
  },
  {
    "text": "国家政权是核心。",
    "start": 45.482,
    "end": 47.604
  },
  {
    "text": "第二，【经济基础决定上层建筑】。",
    "start": 47.604,
    "end": 50.794
  },
  {
    "text": "经济基础决定上层建筑的产生，性质和发展变革。",
    "start": 50.794,
    "end": 55.807
  },
  {
    "text": "任何上层建筑都是为了维护特定经济基础而建立的。",
    "start": 55.807,
    "end": 60.781
  },
  {
    "text": "第三，【上层建筑对经济基础的反作用及其性质判定】。",
    "start": 60.781,
    "end": 65.69
  },
  {
    "text": "上层建筑反作用于经济基础。",
    "start": 65.69,
    "end": 68.906
  },
  {
    "text": "其反作用的性质（积极或消极），归根到底取决于它所服务的经济基础是否适合生产力的发展。",
    "start": 68.906,
    "end": 77.617
  },
  {
    "text": "名师生动解密。",
    "start": 77.617,
    "end": 79.479
  },
  {
    "text": "制度稳则国家稳，治理效能来自制度与经济基础的紧密契合。",
    "start": 79.479,
    "end": 85.169
  },
  {
    "text": "国家，法律，道德不是孤立漂浮在空中的神迹，而是根植于物质生产关系的土壤。",
    "start": 85.169,
    "end": 92.773
  },
  {
    "text": "为什么我们要进行政治体制改革和法治中国建设？",
    "start": 92.773,
    "end": 97.421
  },
  {
    "text": "就是为了让政治上层建筑更好赋能现代化经济建设。",
    "start": 97.422,
    "end": 102.591
  },
  {
    "text": "经济决定制度，制度反哺繁荣。",
    "start": 102.591,
    "end": 105.742
  },
  {
    "text": "核心总结：采分铁律：政治上层建筑以国家政权为核心；上层建筑反作用的性质取决于其服务对象能否顺应生产力要求。",
    "start": 105.742,
    "end": 117.083
  },
  {
    "text": "徐涛老师点拨：徐涛口诀：经济是底座，制度观念是高楼。",
    "start": 117.083,
    "end": 122.552
  },
  {
    "text": "上层建筑的好坏不看名字，看它能不能帮到底层的生产力解放。",
    "start": 122.552,
    "end": 128.125
  },
  {
    "text": "肖秀荣老师考向精解：肖秀荣点拨：做选择题严防陷阱：上层建筑对经济基础有反作用，但它促进还是阻碍社会发展，取决于经济基础是否适应生产力！",
    "start": 128.125,
    "end": 141.745
  }
]