[
  {
    "text": "在全民族抗战中，中国共产党坚持全面抗战路线，制定了持久战的战略方针。",
    "start": 0.1,
    "end": 7.601
  },
  {
    "text": "面对亡国论与速胜论的错误论调，毛泽东发表《论持久战》。",
    "start": 7.551,
    "end": 12.666
  },
  {
    "text": "科学预测了抗日战争将经历战略防御，战略相持，战略反抗三个阶段。",
    "start": 12.666,
    "end": 19.311
  },
  {
    "text": "指出兵民是胜利之本，抗战胜利的根本保证在于动员最广大人民群众实行人民战争。",
    "start": 19.311,
    "end": 27.283
  },
  {
    "text": "平型关大捷是全民族抗战爆发后中国军队主动寻歼敌人的第一个大胜仗。",
    "start": 27.283,
    "end": 34.03
  },
  {
    "text": "打破了日军不可战胜的神话。",
    "start": 34.031,
    "end": 36.837
  },
  {
    "text": "百团大战是八路军在华北发动的大规模进攻战役，沉重打击了日军的囚笼政策。",
    "start": 36.837,
    "end": 44.184
  },
  {
    "text": "中国共产党领导的敌后战场与国民党指挥的正面战场相互配合。",
    "start": 44.184,
    "end": 50.192
  },
  {
    "text": "构成了全民族抗战的战略格局。",
    "start": 50.191,
    "end": 53.188
  },
  {
    "text": "在抗日民族统一战线中，中国共产党坚持独立自主原则，坚持又联合又斗争。",
    "start": 53.189,
    "end": 60.74
  },
  {
    "text": "以斗争求团结的方针。",
    "start": 60.74,
    "end": 63.1
  },
  {
    "text": "考场大题核心题眼。",
    "start": 63.099,
    "end": 65.369
  },
  {
    "text": "持久战战略防御，相持，反抗三阶段，相持阶段是关键阶段。",
    "start": 65.37,
    "end": 71.429
  },
  {
    "text": "平型关破不可胜，持久论断指航程，相持阶段为枢纽，人民战争显奇能。",
    "start": 71.429,
    "end": 78.1
  }
]