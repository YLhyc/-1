[
  {
    "text": "面对资本主义的内在危机，人类追求解放的理想经历了科学社会主义的伟大飞跃。",
    "start": 0.1,
    "end": 7.359
  },
  {
    "text": "社会主义实现了三大历史性飞跃。",
    "start": 7.309,
    "end": 10.511
  },
  {
    "text": "第一，从空想到科学的飞跃。",
    "start": 10.51,
    "end": 13.405
  },
  {
    "text": "空想社会主义揭露了资本主义的弊端，但找不到社会变革的阶级力量与现实道路。",
    "start": 13.406,
    "end": 20.498
  },
  {
    "text": "马克思恩格斯创立了唯物史观和剩余价值学说。",
    "start": 20.497,
    "end": 25.038
  },
  {
    "text": "把社会主义置于现实科学的基础之上。",
    "start": 25.038,
    "end": 28.648
  },
  {
    "text": "第二，从理论到现实的飞跃。",
    "start": 28.648,
    "end": 31.505
  },
  {
    "text": "列宁领导十月社会主义革命取得伟大胜利，建立了世界上第一个社会主义国家。",
    "start": 31.505,
    "end": 38.201
  },
  {
    "text": "开启了人类历史的新纪元。",
    "start": 38.202,
    "end": 40.868
  },
  {
    "text": "第三，从一国实践到多国发展的飞跃。",
    "start": 40.867,
    "end": 44.655
  },
  {
    "text": "二战后社会主义跨越欧亚大陆，在经历曲折之后。",
    "start": 44.656,
    "end": 49.273
  },
  {
    "text": "中国特色社会主义迎来了蓬勃生机。",
    "start": 49.273,
    "end": 52.691
  },
  {
    "text": "社会主义建设具有艰巨性和长期性，社会主义发展模式具有多样性。",
    "start": 52.691,
    "end": 58.915
  },
  {
    "text": "必须把科学社会主义基本原则同各国具体实际相结合。",
    "start": 58.916,
    "end": 64.056
  },
  {
    "text": "空想批判少阶级，两大学说立科学，十月惊雷开现实，中国道路展磅礴。",
    "start": 64.056,
    "end": 71.224
  }
]