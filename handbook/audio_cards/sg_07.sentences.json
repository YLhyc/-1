[
  {
    "text": "辛亥革命后，面对北洋军阀的黑暗统治，先进知识分子发起了新文化运动。",
    "start": 0.1,
    "end": 6.632
  },
  {
    "text": "陈独秀在上海创办《青年杂志》，高举民主与科学两面大旗。",
    "start": 6.582,
    "end": 12.092
  },
  {
    "text": "向封建礼教和旧道德宣战。",
    "start": 12.092,
    "end": 15.191
  },
  {
    "text": "俄国十月革命的一声炮响，给中国送来了马克思列宁主义。",
    "start": 15.191,
    "end": 20.497
  },
  {
    "text": "李大钊率先在中国举起了马克思主义旗帜，发表《我的马克思主义观》。",
    "start": 20.497,
    "end": 26.441
  },
  {
    "text": "成为中国最早的马克思主义传播者。",
    "start": 26.441,
    "end": 29.694
  },
  {
    "text": "1919年巴黎和会上中国外交失败，彻底点燃了五四运动的导火索。",
    "start": 29.694,
    "end": 35.804
  },
  {
    "text": "五四运动是中国近代史上具有划时代意义的重大事件。",
    "start": 35.804,
    "end": 40.651
  },
  {
    "text": "这是一场彻底反帝反封建的伟大爱国革命运动，社会革命运动和思想启蒙运动。",
    "start": 40.651,
    "end": 47.845
  },
  {
    "text": "中国工人阶级在五四运动后期作为独立的政治力量登上历史舞台。",
    "start": 47.844,
    "end": 54.043
  },
  {
    "text": "展现了伟大的力量。",
    "start": 54.043,
    "end": 56.058
  },
  {
    "text": "五四运动标志着中国新民主主义革命的伟大开端。",
    "start": 56.059,
    "end": 60.702
  },
  {
    "text": "考场避坑。",
    "start": 60.702,
    "end": 62.271
  },
  {
    "text": "新文化运动前期的旗帜是民主与科学，五四运动是中国新民主主义革命的开端。",
    "start": 62.27,
    "end": 69.528
  },
  {
    "text": "德赛二旗唤民智，十月惊雷送真理，五四怒吼工人起，新民主运翻新历。",
    "start": 69.528,
    "end": 76.02
  }
]