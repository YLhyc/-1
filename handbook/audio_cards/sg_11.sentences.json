[
  {
    "text": "面对国民党反动派的残酷围剿。",
    "start": 0.1,
    "end": 3.226
  },
  {
    "text": "第五次反围剿由于王明左倾教条主义的错误指挥而惨遭失败。",
    "start": 3.176,
    "end": 8.852
  },
  {
    "text": "红军被迫实行战略转移，开启了举世闻名的二万五千里长征。",
    "start": 8.852,
    "end": 14.362
  },
  {
    "text": "1935年1月，党中央在长征途中召开了遵义会议。",
    "start": 14.362,
    "end": 19.311
  },
  {
    "text": "遵义会议集中全力解决了当时最紧迫的军事问题和组织问题。",
    "start": 19.311,
    "end": 24.872
  },
  {
    "text": "确立了毛泽东在红军和党中央的领导地位，在极其危急的关头挽救了党。",
    "start": 24.872,
    "end": 31.581
  },
  {
    "text": "挽救了红军，挽救了中国革命。",
    "start": 31.582,
    "end": 34.541
  },
  {
    "text": "遵义会议是党的历史上一个生死攸关的转折点。",
    "start": 34.541,
    "end": 38.89
  },
  {
    "text": "标志着中国共产党在政治上开始走向成熟。",
    "start": 38.89,
    "end": 43.367
  },
  {
    "text": "长征的胜利充分展现了伟大的长征精神。",
    "start": 43.367,
    "end": 47.5
  },
  {
    "text": "把全国人民和中华民族的根本利益看得高于一切，坚信正义事业必然胜利。",
    "start": 47.5,
    "end": 54.247
  },
  {
    "text": "红军三大主力在会宁会师。",
    "start": 54.247,
    "end": 57.244
  },
  {
    "text": "标志着长征胜利结束，宣告了国民党消灭共产党的企图彻底破产。",
    "start": 57.245,
    "end": 63.24
  },
  {
    "text": "考场核心采分点。",
    "start": 63.24,
    "end": 65.332
  },
  {
    "text": "遵义会议解决的是军事和组织问题，思想政治问题是在后来的延安整风中解决的。",
    "start": 65.332,
    "end": 72.475
  },
  {
    "text": "左倾盲动危局现，遵义转折挽狂澜，走向成熟挽大厦，长征万里破重关。",
    "start": 72.474,
    "end": 79.502
  }
]