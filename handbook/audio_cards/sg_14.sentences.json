[
  {
    "text": "为了从思想上肃清党内历次左倾和右倾错误的影响，党在延安开展了全党整风运动。",
    "start": 0.1,
    "end": 8.035
  },
  {
    "text": "延安整风运动的主要内容是。",
    "start": 7.985,
    "end": 10.587
  },
  {
    "text": "反对主观主义以整顿学风，反对宗派主义以整顿党风，反对党八股以整顿文风。",
    "start": 10.587,
    "end": 18.074
  },
  {
    "text": "其中，反对主观主义是整风运动的最主要任务。",
    "start": 18.074,
    "end": 22.36
  },
  {
    "text": "主观主义的主要表现形式是教条主义和经验主义，教条主义是整风的重点。",
    "start": 22.36,
    "end": 29.197
  },
  {
    "text": "整风运动采取惩前毖后，治病救人的方针，通过批评与自我批评。",
    "start": 29.196,
    "end": 35.204
  },
  {
    "text": "实现了全党在思想上的空前团结。",
    "start": 35.204,
    "end": 38.559
  },
  {
    "text": "延安整风是一场伟大的马克思主义思想解放运动。",
    "start": 38.559,
    "end": 43.087
  },
  {
    "text": "确立了实事求是的马克思主义思想路线。",
    "start": 43.087,
    "end": 46.658
  },
  {
    "text": "1945年召开的中共七大，把毛泽东思想确立为全党的指导思想并写入党章。",
    "start": 46.658,
    "end": 53.852
  },
  {
    "text": "中共七大为争取抗日战争的胜利和新民主主。",
    "start": 53.852,
    "end": 58.495
  },
  {
    "text": "义革命在全国的胜利奠定了政治和思想基础。",
    "start": 58.495,
    "end": 63.074
  },
  {
    "text": "考场考眼。",
    "start": 63.074,
    "end": 64.566
  },
  {
    "text": "整风重点是教条主义，最主要任务是反对主观主义。",
    "start": 64.566,
    "end": 69.617
  },
  {
    "text": "七大确立毛泽东思想为指导思想。",
    "start": 69.617,
    "end": 73.01
  },
  {
    "text": "整顿学风除教条，思想解放树求是，延安整风凝全党，七大确立旗帜赤。",
    "start": 73.01,
    "end": 80.038
  }
]