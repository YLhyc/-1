[
  {
    "text": "在理解了唯物主义之后，我们顺着历史脉络追问。",
    "start": 0.1,
    "end": 4.323
  },
  {
    "text": "唯物主义是怎样一步步演进到马克思主义辩证唯物主义的。",
    "start": 4.273,
    "end": 9.452
  },
  {
    "text": "唯物主义在历史上经历了三种形态，每一种形态都受限于当时的科技水平。",
    "start": 9.452,
    "end": 15.906
  },
  {
    "text": "第一种是古代朴素唯物主义。",
    "start": 15.906,
    "end": 18.636
  },
  {
    "text": "古希腊和中国古代哲学家把世界的本原归结为某一种或几种具体的实物。",
    "start": 18.635,
    "end": 24.923
  },
  {
    "text": "比如水，火，气，土。",
    "start": 24.923,
    "end": 28.354
  },
  {
    "text": "它的优点在于坚持了唯物主义大方向，缺点是缺乏科学论证，把复杂的世界直观化。",
    "start": 28.355,
    "end": 36.365
  },
  {
    "text": "猜测化。",
    "start": 36.365,
    "end": 37.666
  },
  {
    "text": "第二种是近代形而上学唯物主义，又叫机械唯物主义。",
    "start": 37.666,
    "end": 42.564
  },
  {
    "text": "随着自然科学发展到原子阶段，哲学家把物质归结为不可分割的原子。",
    "start": 42.564,
    "end": 48.993
  },
  {
    "text": "它虽然有了近代科学支撑，但存在三大致命缺陷。",
    "start": 48.992,
    "end": 53.711
  },
  {
    "text": "机械性，形而上学性，以及历史观上的唯心主义，也就是不彻底性。",
    "start": 53.712,
    "end": 59.554
  },
  {
    "text": "由于把原子当成最终本质，当十九世纪末物理学发现电子，原子可以再分时。",
    "start": 59.554,
    "end": 66.48
  },
  {
    "text": "这种唯物主义就陷入了危机。",
    "start": 66.48,
    "end": 69.363
  },
  {
    "text": "第三种形态正是辩证唯物主义和历史唯物主义。",
    "start": 69.362,
    "end": 74.068
  },
  {
    "text": "马克思恩格斯把唯物论与辩证法有机结合，创立了最高形态的唯物主义。",
    "start": 74.069,
    "end": 80.383
  },
  {
    "text": "考场避坑重点。",
    "start": 80.383,
    "end": 82.309
  },
  {
    "text": "古代唯物主义是直观猜测，近代唯物主义半截子唯心。",
    "start": 82.309,
    "end": 87.513
  },
  {
    "text": "唯有马哲把唯物论贯彻到了社会历史领域。",
    "start": 87.513,
    "end": 91.62
  },
  {
    "text": "古朴直观水火土，近代形而原子孤，唯有马哲融辩证，历史唯物破迷途。",
    "start": 91.62,
    "end": 98.291
  }
]