[
  {
    "text": "在社会主义政治文明建设中，全过程人民民主是社会主义民主政治的本质属性。",
    "start": 0.1,
    "end": 7.027
  },
  {
    "text": "全过程人民民主是最广泛，最真实，最管用的民主。",
    "start": 6.977,
    "end": 12.028
  },
  {
    "text": "最广泛体现在全链条，全方位，全覆盖，全体人民平等享有广泛的民主权利。",
    "start": 12.028,
    "end": 19.196
  },
  {
    "text": "最真实体现在人民当家作主不仅有完整的制度程序，而且有完整的参与实践。",
    "start": 19.196,
    "end": 26.122
  },
  {
    "text": "真正把意愿转化为国家政策。",
    "start": 26.122,
    "end": 29.043
  },
  {
    "text": "最管用体现在能有效解决人民最关心，最直接，最现实的利益问题，治理效能极高。",
    "start": 29.043,
    "end": 36.594
  },
  {
    "text": "推进社会主义民主政治，最根本的是坚持党的领导，人民当家作主。",
    "start": 36.594,
    "end": 43.188
  },
  {
    "text": "依法治国有机统一。",
    "start": 43.189,
    "end": 45.319
  },
  {
    "text": "党的领导是人民当家作主和依法治国的根本保证。",
    "start": 45.319,
    "end": 50.153
  },
  {
    "text": "人民当家作主是社会主义民主政治的本质特征。",
    "start": 50.153,
    "end": 54.49
  },
  {
    "text": "依法治国是党领导人民治理国家的基本方式。",
    "start": 54.49,
    "end": 58.572
  },
  {
    "text": "人民代表大会制度是我国的根本政治制度。",
    "start": 58.571,
    "end": 62.423
  },
  {
    "text": "中国共产党领导的多党合作和政治协商制度。",
    "start": 62.423,
    "end": 66.798
  },
  {
    "text": "民族区域自治制度以及基层群众自治制度是我国的基本政治制度。",
    "start": 66.798,
    "end": 72.818
  },
  {
    "text": "考场大题核心题眼。",
    "start": 72.819,
    "end": 75.089
  },
  {
    "text": "全过程人民民主的三大特性，三者有机统一的关系。",
    "start": 75.089,
    "end": 79.872
  },
  {
    "text": "根本制度与基本制度的严格区分。",
    "start": 79.872,
    "end": 83.227
  },
  {
    "text": "广泛真实最管用，全过程里聚民心，三者统一人民主，制度保障定国均。",
    "start": 83.227,
    "end": 90.102
  }
]