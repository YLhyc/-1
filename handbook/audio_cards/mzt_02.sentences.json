[
  {
    "text": "在马克思主义中国化时代化的伟大进程中，中国共产党创立了一系列重大理论成果。",
    "start": 0.1,
    "end": 7.588
  },
  {
    "text": "毛泽东思想，邓小平理论，三个代表重要思想，科学发展观。",
    "start": 7.538,
    "end": 13.137
  },
  {
    "text": "以及习近平新时代中国特色社会主义思想。",
    "start": 13.138,
    "end": 17.22
  },
  {
    "text": "这些理论成果之间究竟是怎样的辩证关系。",
    "start": 17.219,
    "end": 21.39
  },
  {
    "text": "它们是一脉相承又与时俱进的科学体系。",
    "start": 21.39,
    "end": 25.523
  },
  {
    "text": "一脉相承体现在。",
    "start": 25.523,
    "end": 27.577
  },
  {
    "text": "它们都坚持马克思列宁主义的根本原则，坚持实事求是的思想路线。",
    "start": 27.577,
    "end": 33.674
  },
  {
    "text": "坚持为人民服务的根本宗旨，具有相同的世界观和方法论底色。",
    "start": 33.673,
    "end": 39.413
  },
  {
    "text": "与时俱进体现在。",
    "start": 39.413,
    "end": 41.301
  },
  {
    "text": "它们分别扎根于不同的历史时代，直面不同的时代课题。",
    "start": 41.301,
    "end": 46.263
  },
  {
    "text": "回答了不同时期的历史之问。",
    "start": 46.263,
    "end": 48.98
  },
  {
    "text": "毛泽东思想回答了怎样进行新民主主义革命和社会主义改造。",
    "start": 48.98,
    "end": 54.784
  },
  {
    "text": "建立了社会主义基本制度。",
    "start": 54.783,
    "end": 57.283
  },
  {
    "text": "邓小平理论首要回答了什么是社会主义，怎样建设社会主义。",
    "start": 57.283,
    "end": 62.717
  },
  {
    "text": "三个代表重要思想回答了建设什么样的党，怎样建设党。",
    "start": 62.717,
    "end": 68.036
  },
  {
    "text": "科学发展观回答了实现什么样的发展，怎样发展。",
    "start": 68.036,
    "end": 72.526
  },
  {
    "text": "新思想在新时代回答了新时代坚持和发展什么样的中国特色社会主义。",
    "start": 72.526,
    "end": 78.776
  },
  {
    "text": "怎样坚持和发展中国特色社会主义。",
    "start": 78.776,
    "end": 82.411
  },
  {
    "text": "考场大题核心采分。",
    "start": 82.411,
    "end": 84.783
  },
  {
    "text": "既要看到思想的连续性与统一性，又要看到各阶段创新成果的针对性与时代跨越。",
    "start": 84.783,
    "end": 92.079
  },
  {
    "text": "一脉相承守初心，与时俱进答时代，理论创新无止境，复兴伟业汇华彩。",
    "start": 92.079,
    "end": 98.941
  }
]