[
  {
    "text": "在社会基本矛盾的推动下，人类社会形态经历了由低级到高级的演进。",
    "start": 0.1,
    "end": 6.16
  },
  {
    "text": "社会形态是同生产力发展一定阶段相适应的经济基础与上层建筑的统一体。",
    "start": 6.11,
    "end": 12.959
  },
  {
    "text": "五种社会形态演进体现了历史发展的统一性。",
    "start": 12.959,
    "end": 17.104
  },
  {
    "text": "原始社会，奴隶社会，封建社会，资本主义社会，共产主义社会。",
    "start": 17.105,
    "end": 23.011
  },
  {
    "text": "同时，各个国家和民族由于历史文化和国际环境不同。",
    "start": 23.01,
    "end": 28.38
  },
  {
    "text": "社会形态更替又具有多样性与曲折性。",
    "start": 28.38,
    "end": 32.13
  },
  {
    "text": "历史必然性规定了社会形态更替的大方向。",
    "start": 32.13,
    "end": 36.071
  },
  {
    "text": "但历史主体的选择性决定了具体实现路径。",
    "start": 36.071,
    "end": 39.961
  },
  {
    "text": "历史主体的选择性绝不是随心所欲，它必须以客观历史条件为基础。",
    "start": 39.961,
    "end": 46.084
  },
  {
    "text": "并最终符合历史发展的客观规律。",
    "start": 46.084,
    "end": 49.298
  },
  {
    "text": "中国跳过资本主义成熟阶段直接走上社会主义道路。",
    "start": 49.298,
    "end": 54.068
  },
  {
    "text": "正是历史规律必然性与主体能动选择性的光辉典范。",
    "start": 54.069,
    "end": 58.967
  },
  {
    "text": "考场辨析。",
    "start": 58.967,
    "end": 60.51
  },
  {
    "text": "承认主体的历史选择性，绝不等于唯心主义英雄造史观。",
    "start": 60.51,
    "end": 65.548
  },
  {
    "text": "任何选择都受制于既定的历史条件。",
    "start": 65.548,
    "end": 68.979
  },
  {
    "text": "五态更替显大道，民族路径展殊途，客观规律筑基石，能动选择绘宏图。",
    "start": 68.98,
    "end": 76.11
  }
]