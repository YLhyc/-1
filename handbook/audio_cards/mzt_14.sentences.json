[
  {
    "text": "1957年毛泽东发表《关于正确处理人民内部矛盾的问题》。",
    "start": 0.1,
    "end": 5.229
  },
  {
    "text": "创立了社会主义两类矛盾学说。",
    "start": 5.179,
    "end": 8.202
  },
  {
    "text": "在社会主义社会确立后，我国国内的主要矛盾发生了转变。",
    "start": 8.202,
    "end": 13.228
  },
  {
    "text": "党的八大指出，主要矛盾是人民对于经济文化迅速发展的。",
    "start": 13.227,
    "end": 18.571
  },
  {
    "text": "需要同当前经济文化不能满足人民需要的状况之间的矛盾。",
    "start": 18.571,
    "end": 23.456
  },
  {
    "text": "毛泽东深刻指出，社会主义社会存在两类性质完全不同的矛盾。",
    "start": 23.457,
    "end": 29.388
  },
  {
    "text": "第一类是敌我矛盾，是对抗性的矛盾，必须采用专政的方法来解决。",
    "start": 29.388,
    "end": 35.306
  },
  {
    "text": "第二类是人民内部矛盾，是非对抗性的矛盾，必须采用民主的方法来解决。",
    "start": 35.306,
    "end": 41.543
  },
  {
    "text": "毛泽东强调，正确处理人民内部矛盾是国家政治生活的主题。",
    "start": 41.543,
    "end": 47.028
  },
  {
    "text": "解决人民内部矛盾的科学总方针是团结，批评，团结。",
    "start": 47.028,
    "end": 52.385
  },
  {
    "text": "在政治上实行团结，批评，团结，在党派关系上实行长期共存，互相监督。",
    "start": 52.385,
    "end": 59.949
  },
  {
    "text": "在科学文化上实行百花齐放，百家争鸣，在经济上实行统筹兼顾，适当安排。",
    "start": 59.949,
    "end": 67.385
  },
  {
    "text": "考场选择题陷阱。",
    "start": 67.385,
    "end": 69.502
  },
  {
    "text": "两类矛盾的性质不同，但敌我矛盾与人民内部矛盾在一定条件下可以相互转化。",
    "start": 69.503,
    "end": 76.582
  },
  {
    "text": "正确处理人民内部矛盾是政治生活的主题。",
    "start": 76.582,
    "end": 80.485
  },
  {
    "text": "两类矛盾性质殊，敌我专政内部和，百花齐放民主道，团结批评聚力多。",
    "start": 80.485,
    "end": 87.181
  }
]